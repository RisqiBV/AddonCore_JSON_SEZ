{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Good Dispatch Finished Goods Request Schema",
  "description": "JSON contract for Good Dispatch Finished Goods data. One object represents a single finished-goods dispatch transaction with header and detail lines.",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "description": "Good Dispatch Finished Goods header section.",
      "properties": {
        "transactionNo": {
          "type": "string",
          "maxLength": 50,
          "description": "Primary transaction number."
        },
        "transactionDate": {
          "type": "string",
          "description": "Dispatch transaction date. Expected format: DD-MM-YYYY."
        },
        "dispatchTo": {
          "type": "string",
          "maxLength": 50,
          "description": "Dispatch destination."
        },
        "deliveryNoteNo": {
          "type": ["string", "null"],
          "maxLength": 50,
          "description": "Delivery note number."
        },
        "bcCode": {
          "type": ["string", "null"],
          "maxLength": 10,
          "description": "BC customs document code."
        },
        "bcNo": {
          "type": ["string", "null"],
          "maxLength": 10,
          "description": "BC customs document number."
        },
        "bcDate": {
          "type": ["string", "null"],
          "description": "BC customs document date. Expected format: DD-MM-YYYY."
        },
        "deliverTo": {
          "type": ["string", "null"],
          "maxLength": 200,
          "description": "Receiver name or destination address."
        },
        "vehicleId": {
          "type": ["string", "null"],
          "maxLength": 50,
          "description": "Vehicle plate number or vehicle ID."
        }
      },
      "required": [
        "transactionNo",
        "transactionDate",
        "dispatchTo"
      ],
      "additionalProperties": false
    },
    "details": {
      "type": "array",
      "description": "Good Dispatch Finished Goods detail lines.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "orderNo": {
            "type": "string",
            "maxLength": 25,
            "description": "Related order number."
          },
          "colorFinishGood": {
            "type": "string",
            "maxLength": 250,
            "description": "Finished good color."
          },
          "sizeFinishGoodCode": {
            "type": "string",
            "maxLength": 10,
            "description": "Finished good size code."
          },
          "qty": {
            "type": "number",
            "description": "Quantity."
          },
          "nw": {
            "type": ["number", "null"],
            "description": "Net weight."
          },
          "gw": {
            "type": ["number", "null"],
            "description": "Gross weight."
          },
          "batchNo": {
            "type": ["string", "null"],
            "maxLength": 10,
            "description": "Batch number."
          },
          "itemCode": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "Finished good item code."
          },
          "movementType": {
            "type": "string",
            "maxLength": 10,
            "description": "Movement type."
          },
          "reference": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "Reference number or reference information."
          },
          "lineItemNo": {
            "type": "number",
            "description": "Line item number."
          },
          "lineItemnoRef": {
            "type": ["number", "null"],
            "description": "Reference line item number."
          },
          "debitCredit": {
            "type": "string",
            "maxLength": 10,
            "description": "Debit/Credit indicator. Example: DEBIT or CREDIT."
          }
        },
        "required": [
          "orderNo",
          "colorFinishGood",
          "sizeFinishGoodCode",
          "qty",
          "movementType",
          "lineItemNo",
          "debitCredit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "header",
    "details"
  ],
  "additionalProperties": false,
  "payloadExamples": [
