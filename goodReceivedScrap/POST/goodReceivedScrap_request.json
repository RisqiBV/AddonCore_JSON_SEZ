{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Good Received Scrap Request Schema",
  "description": "JSON contract for Good Received Scrap data. One object represents a single scrap receipt transaction with header and detail lines.",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "description": "Good Received Scrap header section.",
      "properties": {
        "transactionNo": {
          "type": "string",
          "maxLength": 50,
          "description": "Primary transaction number."
        },
        "transactionDate": {
          "type": "string",
          "description": "Transaction date. Expected format: DD-MM-YYYY."
        },
        "department": {
          "type": "string",
          "maxLength": 100,
          "description": "Department name."
        }
      },
      "required": [
        "transactionNo",
        "transactionDate",
        "department"
      ],
      "additionalProperties": false
    },
    "details": {
      "type": "array",
      "description": "Good Received Scrap detail lines.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "scrapCode": {
            "type": "string",
            "maxLength": 50,
            "description": "Scrap code."
          },
          "description": {
            "type": "string",
            "maxLength": 100,
            "description": "Scrap description."
          },
          "qty": {
            "type": "number",
            "description": "Quantity."
          },
          "unitCode": {
            "type": "string",
            "maxLength": 10,
            "description": "Unit of measure code."
          },
          "orderNo": {
            "type": "string",
            "maxLength": 25,
            "description": "Related order number."
          },
          "itemCode": {
            "type": "string",
            "maxLength": 50,
            "description": "Related material item code."
          },
          "batchNo": {
            "type": ["string", "null"],
            "maxLength": 10,
            "description": "Batch number."
          },
          "movementType": {
            "type": "string",
            "maxLength": 10,
            "description": "Movement type."
          },
          "reference": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "Reference number or reference information."
          },
          "lineItemNo": {
            "type": "number",
            "description": "Line item number."
          },
          "lineItemNoRef": {
            "type": ["number", "null"],
            "description": "Reference line item number."
          },
          "debitCredit": {
            "type": "string",
            "maxLength": 10,
            "description": "Debit or credit indicator."
          }
        },
        "required": [
          "scrapCode",
          "description",
          "qty",
          "unitCode",
          "orderNo",
          "itemCode",
          "movementType",
          "lineItemNo",
          "debitCredit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "header",
    "details"
  ],
  "additionalProperties": false,
  "payloadExamples": [
    {
      "header": {
        "transactionNo": "GRSCRAP/2026/0001",
        "transactionDate": "15-05-2026",
        "department": "Cutting"
      },
      "details": [
        {
          "scrapCode": "SCRP-01",
          "description": "Scrap Iron Import",
          "qty": 2,
          "unitCode": "KGM",
          "orderNo": "ADDON/ORDER/0001/V/2026",
          "itemCode": "Rawmaterial001",
          "batchNo" : "0001",
          "movementType": "IN",
          "reference": null,
          "lineItemNo": 1,
          "lineItemNoRef": null,
          "debitCredit": "DEBIT"
        },
        {
          "scrapCode": "SCRP-02",
          "description": "Scrap Fabric Local",
          "qty": 1.5,
          "unitCode": "KGM",
          "orderNo": "ADDON/ORDER/0002/V/2026",
          "itemCode": "Rawmaterial002",
          "batchNo" : "0001",
          "movementType": "IN",
          "reference": "CUT/2026/0001",
          "lineItemNo": 2,
          "lineItemNoRef": 1,
          "debitCredit": "DEBIT"
        }
      ]
    },
    {
      "header": {
        "transactionNo": "GRSCRAP/2026/0002",
        "transactionDate": "15-05-2026",
        "department": "Sewing"
      },
      "details": [
        {
          "scrapCode": "SCRP-03",
          "description": "Scrap Thread",
          "qty": 5,
          "unitCode": "KGM",
          "orderNo": "ADDON/ORDER/0003/V/2026",
          "itemCode": "Thread001",
          "batchNo" : "0001",
          "movementType": "IN",
          "reference": "SEW/2026/0001",
          "lineItemNo": 1,
          "lineItemNoRef": null,
          "debitCredit": "DEBIT"
        }
      ]
    }
  ]
}