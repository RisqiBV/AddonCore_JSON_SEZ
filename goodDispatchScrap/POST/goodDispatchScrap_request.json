{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Good Dispatch Scrap (Header–Detail) Schema",
  "description": "One object represents a single scrap dispatch: header + detail lines.",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "description": "Dispatch header section.",
      "properties": {
        "transactionNo": {
          "type": "string",
          "maxLength": 50,
          "description": "Primary transaction number."
        },
        "transactionDate": {
          "type": "string",
          "description": "Dispatch date. Expected format: DD-MM-YYYY."
        },
        "deliveryNoteNo": {
          "type": "string",
          "maxLength": 50,
          "description": "Delivery note number."
        },
        "deliverTo": {
          "type": "string",
          "maxLength": 200,
          "description": "Receiver name/address."
        },
        "vehicleId": {
          "type": "string",
          "maxLength": 50,
          "description": "Vehicle plate/ID."
        },
        "bcCode": {
          "type": "string",
          "maxLength": 10,
          "description": "BC customs code."
        },
        "bcNo": {
          "type": "string",
          "maxLength": 10,
          "description": "BC document number."
        },
        "bcDate": {
          "type": "string",
          "description": "BC document date. Expected format: DD-MM-YYYY."
        }
      },
      "required": [
        "transactionNo",
        "transactionDate",
        "deliveryNoteNo",
        "deliverTo",
        "vehicleId",
        "bcCode",
        "bcNo",
        "bcDate"
      ],
      "additionalProperties": false
    },
    "details": {
      "type": "array",
      "description": "Scrap detail lines for this dispatch.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "scrapCode": {
            "type": "string",
            "maxLength": 50,
            "description": "Scrap code."
          },
          "qty": {
            "type": "number",
            "description": "Quantity."
          },
          "unitCode": {
            "type": "string",
            "maxLength": 10,
            "description": "Unit of measure."
          },
          "nw": {
            "type": "number",
            "description": "Net weight in KGM."
          },
          "gw": {
            "type": "number",
            "description": "Gross weight in KGM."
          },
          "batchNo": {
            "type": ["string", "null"],
            "maxLength": 10,
            "description": "Batch number."
          },
          "movementType": {
            "type": "string",
            "maxLength": 10,
            "description": "Movement type."
          },
          "reference": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "Reference number or reference information."
          },
          "lineItemNo": {
            "type": "number",
            "description": "Line item number."
          },
          "lineItemNoRef": {
            "type": ["number", "null"],
            "description": "Reference line item number."
          },
          "debitCredit": {
            "type": "string",
            "maxLength": 10,
            "description": "Debit/Credit indicator. Example: DEBIT or CREDIT."
          }
        },
        "required": [
          "scrapCode",
          "qty",
          "unitCode",
          "nw",
          "gw",
          "movementType",
          "lineItemNo",
          "debitCredit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "header",
    "details"
  ],
  "additionalProperties": false,
  "payloadExamples": [
    {
      "header": {
        "transactionNo": "0009/IX/2025",
        "transactionDate": "09-08-2025",
        "deliveryNoteNo": "SJ/004/2025",
        "deliverTo": "CV. Mentari Pagi",
        "vehicleId": "B 3451 BTS",
        "bcCode": "632",
        "bcNo": "000013",
        "bcDate": "09-08-2025"
      },
      "details": [
        {
          "scrapCode": "SCRP-01",
          "qty": 2,
          "unitCode": "KGM",
          "nw": 2,
          "gw": 2.1,
          "batchNo": "BATCH001",
          "movementType": "OUT",
          "reference": "REF-SCRAP-001",
          "lineItemNo": 1,
          "lineItemNoRef": null,
          "debitCredit": "CREDIT"
        },
        {
          "scrapCode": "SCRP-01",
          "qty": 1,
          "unitCode": "KGM",
          "nw": 1,
          "gw": 1.05,
          "batchNo": null,
          "movementType": "OUT",
          "reference": "REF-SCRAP-001",
          "lineItemNo": 2,
          "lineItemNoRef": null,
          "debitCredit": "CREDIT"
        }
      ]
    },
    {
      "header": {
        "transactionNo": "0010/IX/2025",
        "transactionDate": "10-08-2025",
        "deliveryNoteNo": "SJ/005/2025",
        "deliverTo": "CV. Mentari Pagi",
        "vehicleId": "B 8899 ADD",
        "bcCode": "632",
        "bcNo": "000014",
        "bcDate": "10-08-2025"
      },
      "details": [
        {
          "scrapCode": "SCRP-02",
          "qty": 5,
          "unitCode": "KGM",
          "nw": 5,
          "gw": 5.25,
          "batchNo": "BATCH002",
          "movementType": "IN",
          "reference": "ADJ-SCRAP-001",
          "lineItemNo": 1,
          "lineItemNoRef": null,
          "debitCredit": "DEBIT"
        }
      ]
    }
  ]
}