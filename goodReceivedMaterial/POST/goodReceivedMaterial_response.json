{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Good Received Material Response Schema",
  "description": "JSON response contract for Good Received Material API.",
  "oneOf": [
    {
      "title": "Success Response",
      "description": "Response returned when Good Received Material data is successfully saved.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "Success message."
        },
        "data": {
          "type": "array",
          "description": "Saved Good Received Material data.",
          "items": {
            "type": "object",
            "properties": {
              "header": {
                "type": "object",
                "description": "Saved GR Material header data.",
                "properties": {
                  "uuidHeader": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Unique identifier generated by the system for the header."
                  },
                  "transactionNo": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Primary transaction number."
                  },
                  "transactionDate": {
                    "type": "string",
                    "description": "Transaction date (DD-MM-YYYY)."
                  },
                  "poNo": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Related PO number."
                  },
                  "bcCode": {
                    "type": ["string", "null"],
                    "maxLength": 10,
                    "description": "BC customs code."
                  },
                  "bcNo": {
                    "type": ["string", "null"],
                    "maxLength": 10,
                    "description": "BC document number."
                  },
                  "bcDate": {
                    "type": ["string", "null"],
                    "description": "BC document date."
                  }
                },
                "required": [
                  "uuidHeader",
                  "transactionNo",
                  "transactionDate",
                  "poNo",
                  "bcCode",
                  "bcNo",
                  "bcDate"
                ],
                "additionalProperties": false
              },
              "details": {
                "type": "array",
                "description": "Saved Good Received Material detail data.",
                "items": {
                  "type": "object",
                  "properties": {
                    "uuid": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier of the detail row."
                    },
                    "uuidHeader": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier of the related header."
                    },
                    "fc": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Document type (PO/FOC)."
                    },
                    "orderNo": {
                      "type": "string",
                      "maxLength": 25,
                      "description": "Related order number."
                    },
                    "itemCode": {
                      "type": "string",
                      "maxLength": 50,
                      "description": "Material or item code."
                    },
                    "vendorQty": {
                      "type": ["number", "string"],
                      "description": "Vendor quantity."
                    },
                    "vendorUnitCode": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Vendor unit code."
                    },
                    "internalQty": {
                      "type": "number",
                      "description": "Internal quantity."
                    },
                    "internalUnitCode": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Internal unit code."
                    },
                    "unitPrice": {
                      "type": ["number", "string"],
                      "description": "Unit price."
                    },
                    "rate": {
                      "type": ["number", "string"],
                      "description": "Rate for calculation."
                    },
                    "lineItemNo": {
                      "type": "number",
                      "description": "Line item number."
                    },
                    "batchNo": {
                      "type": ["string", "null"],
                      "maxLength": 10,
                      "description": "Batch number."
                    },
                    "movementType": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Movement type."
                    },
                    "reference": {
                      "type": ["string", "null"],
                      "maxLength": 50,
                      "description": "Reference number or reference information."
                    },
                    "lineItemNoRef": {
                      "type": ["number", "null"],
                      "description": "Reference line item number."
                    },
                    "debitCredit": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Debit or credit indicator."
                    }
                  },
                  "required": [
                    "uuid",
                    "uuidHeader",
                    "fc",
                    "orderNo",
                    "itemCode",
                    "vendorQty",
                    "vendorUnitCode",
                    "internalQty",
                    "internalUnitCode",
                    "unitPrice",
                    "rate",
                    "lineItemNo",
                    "batchNo"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "header",
              "details"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "message", "data"],
      "additionalProperties": false
    },
    {
      "title": "General Error Response",
      "description": "Response returned when validation, duplicate data, or server error occurs.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["error"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "General error message."
        },
        "errors": {
          "type": ["object", "null"],
          "description": "Detailed error information."
        }
      },
      "required": ["status", "message", "errors"],
      "additionalProperties": false
    }
  ]
}