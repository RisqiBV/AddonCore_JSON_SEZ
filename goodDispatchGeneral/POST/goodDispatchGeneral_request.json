          "gw": 22,
          "movementType": "OUT",
          "reference": "REQ/2026/0001",
          "lineItemNo": 2,
          "lineItemnoRef": 1
        }
      ]
    },
    {
      "header": {
        "transactionNo": "GDG/2026/0002",
        "transactionDate": "15-05-2026",
        "dispatchTo": "Production",
        "deliveryNoteNo": "SJ/2026/0002",
        "bcCode": "632",
        "bcNo": "000013",
        "bcDate": "15-05-2026",
