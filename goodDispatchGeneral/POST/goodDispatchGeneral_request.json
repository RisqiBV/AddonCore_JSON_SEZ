{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Good Dispatch General Request Schema",
  "description": "JSON contract for Good Dispatch General data. One object represents a single general dispatch transaction with header and detail lines.",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "description": "Good Dispatch General header section.",
      "properties": {
        "transactionNo": {
          "type": "string",
          "maxLength": 50,
          "description": "Primary transaction number."
        },
        "transactionDate": {
          "type": "string",
          "description": "Dispatch transaction date. Expected format: DD-MM-YYYY."
        },
        "dispatchTo": {
          "type": "string",
          "maxLength": 50,
          "description": "Dispatch destination. Default value is Production."
        },
        "deliveryNoteNo": {
          "type": ["string", "null"],
          "maxLength": 50,
          "description": "Delivery note number."
        },
        "bcCode": {
          "type": ["string", "null"],
          "maxLength": 10,
          "description": "BC customs document code."
        },
        "bcNo": {
          "type": ["string", "null"],
          "maxLength": 10,
          "description": "BC customs document number."
        },
        "bcDate": {
          "type": ["string", "null"],
          "description": "BC customs document date. Expected format: DD-MM-YYYY."
        },
        "deliverTo": {
          "type": ["string", "null"],
          "maxLength": 200,
          "description": "Receiver name or destination address."
        },
        "vehicleId": {
          "type": ["string", "null"],
          "maxLength": 50,
          "description": "Vehicle plate number or vehicle ID."
        }
      },
      "required": [
        "transactionNo",
        "transactionDate",
        "dispatchTo"
      ],
      "additionalProperties": false
    },
    "details": {
      "type": "array",
      "description": "Good Dispatch General detail lines.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "qty": {
            "type": "number",
            "description": "Quantity. Database type: decimal(18,4)."
          },
          "itemCode": {
            "type": "string",
            "maxLength": 50,
            "description": "General item code."
          },
          "unitCode": {
            "type": "string",
            "maxLength": 10,
            "description": "Unit of measure code."
          },
          "nw": {
            "type": ["number", "null"],
            "description": "Net weight."
          },
          "gw": {
            "type": ["number", "null"],
            "description": "Gross weight."
          },
          "movementType": {
            "type": "string",
            "maxLength": 10,
            "description": "Movement type."
          },
          "reference": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "Reference number or reference information."
          },
          "lineItemNo": {
            "type": "number",
            "description": "Line item number."
          },
          "lineItemnoRef": {
            "type": ["number", "null"],
            "description": "Reference line item number."
          }
        },
        "required": [
          "qty",
          "itemCode",
          "unitCode",
          "movementType",
          "lineItemNo"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "header",
    "details"
  ],
  "additionalProperties": false,
  "payloadExamples": [
    {
      "header": {
        "transactionNo": "GDG/2026/0001",
        "transactionDate": "15-05-2026",
        "dispatchTo": "Production",
        "deliveryNoteNo": null,
        "bcCode": null,
        "bcNo": null,
        "bcDate": null,
        "deliverTo": null,
        "vehicleId": null
      },
      "details": [
        {
          "qty": 5,
          "itemCode": "MCH1",
          "unitCode": "PCE",
          "nw": null,
          "gw": null,
          "movementType": "OUT",
          "reference": null,
          "lineItemNo": 1,
          "lineItemnoRef": null
        },
        {
          "qty": 10,
          "itemCode": "MCH2",
          "unitCode": "PCE",
