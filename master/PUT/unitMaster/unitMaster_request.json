{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unit Master PUT Schema",
  "description": "JSON contract for updating Unit Master data by uuid. All fields should be sent with their current or updated values to maintain data consistency.",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "List of unit master records to be updated.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid",
            "description": "Primary key for update. Required. System will update data only if uuid exists in database."
          },
          "internalUnitCode": {
            "type": "string",
            "maxLength": 10,
            "description": "Internal unit code. Not updateable, but must be sent with original value."
          },
          "unitDescription": {
            "type": "string",
            "maxLength": 50,
            "description": "Description of the unit. Updateable."
          },
          "aliasUnitCode": {
            "type": "string",
            "maxLength": 10,
            "description": "Code referencing the standard INSW unit. Updateable. See UnitINSW.code reference."
          }
        },
        "required": [
          "uuid",
          "internalUnitCode",
          "unitDescription",
          "aliasUnitCode"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "data": [
        {
            "uuid": "df94214c-579d-47a6-bb97-d30d4fa54ea0",
            "internalUnitCode": "LTR",
            "unitDescription": "Litre(Internal) - Revision",
            "aliasUnitCode": "LTR"
        },
        {
            "uuid": "db50cb54-4792-4aba-9c91-b233e6d0abd5",
            "internalUnitCode": "M",
            "unitDescription": "Meter(1) - Revision",
            "aliasUnitCode": "MTR"
        }
      ]
    }
  ]
}