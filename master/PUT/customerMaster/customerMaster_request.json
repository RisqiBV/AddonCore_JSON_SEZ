{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Customer Master PUT Schema",
  "description": "JSON contract for updating Customer Master data by uuid. This endpoint supports bulk update through data array.",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "List of customer master records to be updated.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid",
            "description": "Primary key for update. Required. System will update data only if uuid exists in database."
          },
          "customerCode": {
            "type": "string",
            "maxLength": 10,
            "description": "Customer code. Not updateable, but must be sent with original value."
          },
          "customerName": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer name. Updateable."
          },
          "address": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer address. Updateable."
          },
          "city": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "City. Updateable."
          },
          "province": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "Province or state. Updateable."
          },
          "country": {
            "type": "string",
            "maxLength": 50,
            "description": "Country. Updateable."
          },
          "npwp": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "Tax ID / NPWP. Updateable."
          }
        },
        "required": [
          "uuid",
          "customerCode",
          "customerName",
          "address",
          "country"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "data": [
        {
            "uuid": "37d172d2-8ad3-4c75-a878-28cd5bc7f45c",
            "customerCode": "ADDON",
            "customerName": "PT Addon Finance Indonesia",
            "address": "Yogyakarta - Edit",
            "city": "Yogyakarta",
            "province": "DIY",
            "country": "INDONESIA",
            "npwp": null
        },
        {
            "uuid": "f4de1728-a5f0-4273-acbd-d38b590f5024",
            "customerCode": "LDP",
            "customerName": "PT Lintas Data Prima",
            "address": "Yogyakarta",
            "city": "Yogyakarta",
            "province": "DIY",
            "country": "INDONESIA",
            "npwp": "192.221.233.111"
        }
      ]
    }
  ]
}