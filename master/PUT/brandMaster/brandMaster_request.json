{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Customer Brand PUT Schema",
  "description": "JSON contract for updating Customer Brand data by uuid. This endpoint supports bulk update through data array.",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "List of brand master records to be updated.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid",
            "description": "Primary key for update. Required. System will update data only if uuid exists in database."
          },
          "customerCode": {
            "type": "string",
            "maxLength": 20,
            "description": "Customer code. Updateable"
          },
          "brandCode": {
            "type": "string",
            "maxLength": 20,
            "description": "Brand code. Not updateable, but must be sent with original value.."
          },
          "brandName": {
            "type": "string",
            "maxLength": 50,
            "description": "Brand name. Updateable."
          }
        },
        "required": [
          "uuid",
          "customerCode",
          "brandCode",
          "brandName"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "data": [
        {
          "uuid": "0b6b0d8a-56a0-4d5b-ab7d-6c27723727c3",
          "customerCode": "ADDON",
          "brandCode": "ERP",
          "brandName": "AFI ERP - 2029"
        },
        {
          "uuid": "df97d5dc-31e1-4226-8ca9-a9593b71e39b",
          "customerCode": "LDP",
          "brandCode": "NETWORK",
          "brandName": "Speed Up by LDP V2"
        }
      ]
    }
  ]
}