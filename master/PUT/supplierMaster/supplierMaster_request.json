{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Supplier Master PUT Schema",
  "description": "JSON contract for updating Supplier Master data by uuid. All fields should be sent with their current or updated values to maintain data consistency.",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "List of supplier master records to be updated.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid",
            "description": "Primary key for update. Required. System will update data only if uuid exists in database."
          },
          "supplierCode": {
            "type": "string",
            "maxLength": 50,
            "description": "Supplier code. Not updateable, but must be sent with original value."
          },
          "supplierName": {
            "type": "string",
            "maxLength": 200,
            "description": "Supplier name. Updateable."
          },
          "address": {
            "type": "string",
            "maxLength": 200,
            "description": "Address of the supplier. Updateable."
          },
          "stateOrProvince": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "State or Province. Updateable. Can be null."
          },
          "countryOrRegion": {
            "type": "string",
            "maxLength": 50,
            "description": "Country or region. Updateable."
          },
          "city": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "City. Updateable. Can be null."
          },
          "npwp": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "Tax ID / NPWP. Updateable. Can be null."
          },
          "emailAddress": {
            "type": ["string", "null"],
            "maxLength": 50,
            "format": "email",
            "description": "Email address. Updateable. Can be null."
          },
          "businessPhone": {
            "type": ["string", "null"],
            "maxLength": 25,
            "description": "Business phone number. Updateable. Can be null."
          },
          "faxNo": {
            "type": ["string", "null"],
            "maxLength": 25,
            "description": "Fax number. Updateable. Can be null."
          },
          "zipOrPostalCode": {
            "type": ["string", "null"],
            "maxLength": 15,
            "description": "ZIP or postal code. Updateable. Can be null."
          }
        },
        "required": [
          "uuid",
          "supplierCode",
          "supplierName",
          "address",
          "stateOrProvince",
          "countryOrRegion",
          "city",
          "npwp",
          "emailAddress",
          "businessPhone",
          "faxNo",
          "zipOrPostalCode"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "data": [
        {
            "uuid": "8723b2a2-07fa-4fd3-a228-442ceab3b9e7",
            "supplierCode": "AFI0001",
            "supplierName": "PT Addon Finance Indonesia",
            "address": "Sudirman - Revision",
            "stateOrProvince": "Jakarta Pusat",
            "countryOrRegion": "Indonesia",
            "city": "Jakarta",
            "npwp": null,
            "emailAddress": "addonfinance@addonfinance.com",
            "businessPhone": "021-6900546",
            "faxNo": "021-6900546",
            "zipOrPostalCode": "14430"
        },
        {
            "uuid": "5b1c3f03-c139-42f7-a3bf-16631b2e717d",
            "supplierCode": "LDP00001",
            "supplierName": "PT Lintas Data Prima",
            "address": "Kuningan",
            "stateOrProvince": "Jakarta Timur",
            "countryOrRegion": "Indonesia",
            "city": "Jakarta",
            "npwp": "1231231231",
            "emailAddress": "ldp@ldp.com",
            "businessPhone": "021-4608847",
            "faxNo": "021-4608847",
            "zipOrPostalCode": "13930"
        }
      ]
    }
  ]
}