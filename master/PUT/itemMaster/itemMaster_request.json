{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Item Master PUT Schema",
  "description": "JSON contract for updating Item Master data by uuid. All fields should be sent with their current or updated values to maintain data consistency.",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "List of item master records to be updated.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid",
            "description": "Primary key for update. Required. System will update data only if uuid exists in database."
          },
          "itemCode": {
            "type": "string",
            "maxLength": 50,
            "description": "Unique item code. Not updateable, but must be sent with original value."
          },
          "itemName": {
            "type": "string",
            "maxLength": 250,
            "description": "Descriptive name of the item. Updateable."
          },
          "categoryCodeBC": {
            "type": "integer",
            "description": "INSW goods category code. Updateable. See ListOfCategoryBC.CategoryCode for reference."
          },
          "hsCode": {
            "type": ["string", "null"],
            "maxLength": 10,
            "description": "HS Code. Updateable. Can be null."
          },
          "categoryInternal": {
            "type": "string",
            "maxLength": 50,
            "description": "Internal classification or category. Updateable."
          },
          "materialGroupType": {
            "type": "string",
            "maxLength": 50,
            "description": "materialGroupType"
          },
          "baseUom": {
            "type": "string",
            "maxLength": 10,
            "description": "Internal base UOM."
          }
        },
        "required": [
          "uuid",
          "itemCode",
          "itemName",
          "categoryCodeBC",
          "hsCode",
          "categoryInternal"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "data": [
          {
              "uuid": "dc6f4f33-5bbf-4002-9c74-e74e7f76350f",
              "itemCode": "0001.0001.0001.RM",
              "itemName": "Raw Material - Revision",
              "categoryCodeBC": 1,
              "hsCode": "98979695",
              "categoryInternal": "Raw Material",
              "materialGroupType": "Raw Material",
              "baseUom" : "KG"
          },
          {
              "uuid": "eb81efe2-4a1a-4768-8204-150f9509940e",
              "itemCode": "0002.0002.0002.RM",
              "itemName": "Raw Material 02",
              "categoryCodeBC": 2,
              "hsCode": "11223344",
              "categoryInternal": "Raw Material",
              "materialGroupType": "Raw Material",
              "baseUom" : "KG"
          }
      ]
    }
  ]
}