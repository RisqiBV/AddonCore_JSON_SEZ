{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Customer Master Schema",
  "description": "JSON contract for Customer Master data including timestamps.",
  "type": "object",
  "properties": {
    "customerCode": {
      "type": "string",
      "maxLength": 10,
      "description": "Primary key for the customer."
    },
    "customerName": {
      "type": "string",
      "maxLength": 50,
      "description": "Customer name."
    },
    "address": {
      "type": "string",
      "maxLength": 50,
      "description": "Customer address."
    },
    "city": {
      "type": ["string", "null"],
      "maxLength": 50,
      "description": "City (optional)."
    },
    "province": {
      "type": ["string", "null"],
      "maxLength": 50,
      "description": "Province or state (optional)."
    },
    "country": {
      "type": "string",
      "maxLength": 50,
      "description": "Country."
    },
    "npwp": {
      "type": ["string", "null"],
      "maxLength": 50,
      "description": "Tax ID (optional)."
    }
  },
  "required": [
    "customerCode",
    "customerName",
    "address",
    "country"
  ],
  "additionalProperties": false,
  
  "payload examples": [
    {
        "customerCode": "ADDON",
        "customerName": "PT Addon Finance Indonesia",
        "address": "Yogyakarta",
        "city": "Yogyakarta",
        "province": "DIY",
        "country": "INDONESIA",
        "npwp": null
    },
    {
        "customerCode": "LDP",
        "customerName": "PT Lintas Data Prima",
        "address": "Yogyakarta",
        "city": "Yogyakarta",
        "province": "DIY",
        "country": "INDONESIA",
        "npwp": null
    }
  ]
}