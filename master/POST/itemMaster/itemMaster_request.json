{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Item Master Schema",
  "description": "JSON contract for Item Master data, including timestamps. Timestamps follow SQL Server format: 'yyyy-MM-dd HH:mm:ss.SSS'.",
  "type": "object",
  "properties": {
    "itemCode": {
      "type": "string",
      "maxLength": 50,
      "description": "Unique item code (Primary Key)."
    },
    "itemName": {
      "type": "string",
      "maxLength": 250,
      "description": "Descriptive name of the item."
    },
    "categoryCodeBC": {
      "type": "integer",
      "description": "INSW goods category code. See ListOfCategoryBC.CategoryCode for reference.  -> @readme.md"
    },
    "hsCode": {
      "type": ["string", "null"],
      "maxLength": 10,
      "description": "HS Code (optional)."
    },
    "categoryInternal": {
      "type": "string",
      "maxLength": 50,
      "description": "Internal classification or category."
    },
     "materialGroupType": {
      "type": "string",
      "maxLength": 50,
      "description": "materialGroupType"
    },
    "baseUom": {
      "type": "string",
      "maxLength": 10,
      "description": "Internal base UOM."
    }   
  },
  "required": ["itemCode", "itemName", "categoryCodeBC", "categoryInternal"],
  "additionalProperties": false,
  
  "payload examples": [
    {
      "itemCode": "0001.0001.0001.RM",
      "itemName": "Raw Material",
      "categoryCodeBC": 1,
      "hsCode": "98979695",
      "categoryInternal": "Raw Material",
      "materialGroupType" : "Raw Material",
      "baseUom" : "KG"
    },
    {
      "itemCode": "0002.0002.0002.RM",
      "itemName": "Raw Material 02",
      "categoryCodeBC": 1,
      "hsCode": "11223344",
      "categoryInternal": "Raw Material",
      "materialGroupType" : "Raw Material",
      "baseUom" : "KG"
    }
  ]
}