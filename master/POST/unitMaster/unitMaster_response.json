{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unit Master Response Schema",
  "description": "JSON response contract for Unit Master API.",
  "oneOf": [
    {
      "title": "Success Response",
      "description": "Response returned when Unit Master data is successfully saved.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "Success message."
        },
        "data": {
          "type": "array",
          "description": "Saved Unit Master data.",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuid",
                "description": "Unique identifier generated by the system."
              },
              "internalUnitCode": {
                "type": "string",
                "maxLength": 10,
                "description": "Internal unit code."
              },
              "unitDescription": {
                "type": "string",
                "maxLength": 255,
                "description": "Unit description."
              },
              "aliasUnitCode": {
                "type": "string",
                "maxLength": 10,
                "description": "Alias unit code."
              }
            },
            "required": [
              "uuid",
              "internalUnitCode",
              "unitDescription",
              "aliasUnitCode"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "message", "data"],
      "additionalProperties": false
    },
    {
      "title": "General Error Response",
      "description": "Response returned when validation, duplicate data, not found, or server error occurs.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["error"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "General error message."
        },
        "errors": {
          "type": ["object", "null"],
          "description": "Detailed error information. The object key represents the field name or error category.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": ["status", "message", "errors"],
      "additionalProperties": false
    }
  ],
  "responseExamples": {
    "success": {
      "status": "success",
      "message": "Data Master Unit successfully saved",
      "data": [
        {
          "uuid": "df94214c-579d-47a6-bb97-d30d4fa54ea0",
          "internalUnitCode": "LTR",
          "unitDescription": "Litre(Internal)",
          "aliasUnitCode": "LTR"
        },
        {
          "uuid": "db50cb54-4792-4aba-9c91-b233e6d0abd5",
          "internalUnitCode": "M",
          "unitDescription": "Meter(1)",
          "aliasUnitCode": "MTR"
        }
      ]
    },
    "validationError": {
      "status": "error",
      "message": "Validation failed",
      "errors": {
        "internalUnitCode": [
          "The internalUnitCode field is required."
        ],
        "unitDescription": [
          "The unitDescription field is required."
        ]
      }
    },
    "duplicateError": {
      "status": "error",
      "message": "Duplicate data found",
      "errors": {
        "duplicate": [
          "The submitted Unit Master data already exists."
        ]
      }
    },
    "serverError": {
      "status": "error",
      "message": "Internal server error",
      "errors": null
    }
  }
}