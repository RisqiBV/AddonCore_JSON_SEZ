{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Supplier Master Response Schema",
  "description": "JSON response contract for Supplier Master API.",
  "oneOf": [
    {
      "title": "Success Response",
      "description": "Response returned when Supplier Master data is successfully saved.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "Success message."
        },
        "data": {
          "type": "array",
          "description": "Saved Supplier Master data.",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuid",
                "description": "Unique identifier generated by the system."
              },
              "supplierCode": {
                "type": "string",
                "maxLength": 50,
                "description": "Primary key for the supplier."
              },
              "supplierName": {
                "type": "string",
                "maxLength": 200,
                "description": "Supplier name."
              },
              "address": {
                "type": "string",
                "maxLength": 200,
                "description": "Address of the supplier."
              },
              "stateOrProvince": {
                "type": ["string", "null"],
                "maxLength": 50,
                "description": "State or Province."
              },
              "countryOrRegion": {
                "type": "string",
                "maxLength": 50,
                "description": "Country or region."
              },
              "city": {
                "type": ["string", "null"],
                "maxLength": 50,
                "description": "City."
              },
              "npwp": {
                "type": ["string", "null"],
                "maxLength": 50,
                "description": "Tax ID."
              },
              "emailAddress": {
                "type": ["string", "null"],
                "maxLength": 50,
                "format": "email",
                "description": "Email address."
              },
              "businessPhone": {
                "type": ["string", "null"],
                "maxLength": 25,
                "description": "Business phone number."
              },
              "faxNo": {
                "type": ["string", "null"],
                "maxLength": 25,
                "description": "Fax number."
              },
              "zipOrPostalCode": {
                "type": ["string", "null"],
                "maxLength": 15,
                "description": "ZIP or postal code."
              }
            },
            "required": [
              "uuid",
              "supplierCode",
              "supplierName",
              "address",
              "stateOrProvince",
              "countryOrRegion",
              "city",
              "npwp",
              "emailAddress",
              "businessPhone",
              "faxNo",
              "zipOrPostalCode"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "message", "data"],
      "additionalProperties": false
    },
    {
      "title": "General Error Response",
      "description": "Response returned when validation, duplicate data, not found, or server error occurs.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["error"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "General error message."
        },
        "errors": {
          "type": ["object", "null"],
          "description": "Detailed error information. The object key represents the field name or error category.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": ["status", "message", "errors"],
      "additionalProperties": false
    }
  ],
  "responseExamples": {
    "success": {
      "status": "success",
      "message": "Data Master Supplier successfully saved",
      "data": [
        {
          "uuid": "8723b2a2-07fa-4fd3-a228-442ceab3b9e7",
          "supplierCode": "AFI0001",
          "supplierName": "PT Addon Finance Indonesia",
          "address": "Sudirman",
          "stateOrProvince": "Jakarta Pusat",
          "countryOrRegion": "Indonesia",
          "city": "Jakarta",
          "npwp": null,
          "emailAddress": "addonfinance@addonfinance.com",
          "businessPhone": "021-6900546",
          "faxNo": "021-6900546",
          "zipOrPostalCode": "14430"
        },
        {
          "uuid": "5b1c3f03-c139-42f7-a3bf-16631b2e717d",
          "supplierCode": "LDP00001",
          "supplierName": "PT Lintas Data Prima",
          "address": "Kuningan",
          "stateOrProvince": "Jakarta Timur",
          "countryOrRegion": "Indonesia",
          "city": "Jakarta",
          "npwp": null,
          "emailAddress": "ldp@ldp.com",
          "businessPhone": "021-4608847",
          "faxNo": "021-4608847",
          "zipOrPostalCode": "13930"
        }
      ]
    },
    "validationError": {
      "status": "error",
      "message": "Validation failed",
      "errors": {
        "supplierCode": [
          "The supplierCode field is required."
        ],
        "supplierName": [
          "The supplierName field is required."
        ],
        "countryOrRegion": [
          "The countryOrRegion field is required."
        ]
      }
    },
    "duplicateError": {
      "status": "error",
      "message": "Duplicate data found",
      "errors": {
        "duplicate": [
          "The submitted Supplier Master data already exists."
        ]
      }
    },
    "serverError": {
      "status": "error",
      "message": "Internal server error",
      "errors": null
    }
  }
}