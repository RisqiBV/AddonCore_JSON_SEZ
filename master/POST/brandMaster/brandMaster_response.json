{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand Master Response Schema",
  "description": "JSON response contract for Brand Master API.",
  "oneOf": [
    {
      "title": "Success Response",
      "description": "Response returned when Brand Master data is successfully saved.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "Success message."
        },
        "data": {
          "type": "array",
          "description": "Saved Brand Master data.",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuid",
                "description": "Unique identifier generated by the system."
              },
              "customerCode": {
                "type": "string",
                "maxLength": 50,
                "description": "Customer code related to the brand."
              },
              "brandCode": {
                "type": "string",
                "maxLength": 50,
                "description": "Brand code."
              },
              "brandName": {
                "type": "string",
                "maxLength": 200,
                "description": "Brand name."
              }
            },
            "required": [
              "uuid",
              "customerCode",
              "brandCode",
              "brandName"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "message", "data"],
      "additionalProperties": false
    },
    {
      "title": "General Error Response",
      "description": "Response returned when validation, duplicate data, not found, or server error occurs.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["error"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "General error message."
        },
        "errors": {
          "type": ["object", "null"],
          "description": "Detailed error information. The object key represents the field name or error category.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": ["status", "message", "errors"],
      "additionalProperties": false
    }
  ],
  "responseExamples": {
    "success": {
      "status": "success",
      "message": "Data Master Brand successfully saved",
      "data": [
        {
          "uuid": "0b6b0d8a-56a0-4d5b-ab7d-6c27723727c3",
          "customerCode": "ADDON",
          "brandCode": "ERP",
          "brandName": "AFI ERP"
        },
        {
          "uuid": "df97d5dc-31e1-4226-8ca9-a9593b71e39b",
          "customerCode": "LDP",
          "brandCode": "NETWORK",
          "brandName": "Speed Up by LDP"
        }
      ]
    },
    "validationError": {
      "status": "error",
      "message": "Validation failed",
      "errors": {
        "customerCode": [
          "The customerCode field is required."
        ],
        "brandCode": [
          "The brandCode field is required."
        ],
        "brandName": [
          "The brandName field is required."
        ]
      }
    },
    "duplicateError": {
      "status": "error",
      "message": "Duplicate data found",
      "errors": {
        "duplicate": [
          "The submitted Brand Master data already exists."
        ]
      }
    },
    "notFoundError": {
      "status": "error",
      "message": "Related data not found",
      "errors": {
        "customerCode": [
          "Customer data with the specified customerCode was not found."
        ]
      }
    },
    "serverError": {
      "status": "error",
      "message": "Internal server error",
      "errors": null
    }
  }
}