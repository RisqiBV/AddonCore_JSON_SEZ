{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Settlement Asset Response Schema",
    "description": "JSON response contract for the Settlement Asset API.",
    "oneOf": [
        {
            "title": "Success Response",
            "description": "Response returned when Settlement Asset data is successfully saved.",
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "success"
                    ],
                    "description": "Response status indicating that the request was successfully processed."
                },
                "message": {
                    "type": "string",
                    "description": "Message describing the successful operation."
                },
                "data": {
                    "type": "array",
                    "description": "List of saved Settlement Asset transactions.",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "properties": {
                            "uuidHeader": {
                                "type": "string",
                                "format": "uuid",
                                "description": "Unique identifier generated by the system for the Settlement Asset transaction header."
                            },
                            "transactionNo": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 50,
                                "description": "Settlement Asset transaction number."
                            },
                            "transactionDate": {
                                "type": "string",
                                "format": "date",
                                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
                                "description": "Settlement Asset transaction date in YYYY-MM-DD format."
                            },
                            "assets": {
                                "type": "array",
                                "description": "List of saved asset detail lines.",
                                "minItems": 1,
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "uuid": {
                                            "type": "string",
                                            "format": "uuid",
                                            "description": "Unique identifier generated by the system for the asset detail row."
                                        },
                                        "uuidHeader": {
                                            "type": "string",
                                            "format": "uuid",
                                            "description": "Unique identifier of the related Settlement Asset transaction header."
                                        },
                                        "itemCodeAsset": {
                                            "type": "string",
                                            "minLength": 1,
                                            "maxLength": 50,
                                            "description": "Asset item code."
                                        },
                                        "assetQty": {
                                            "type": [
                                                "number",
                                                "string"
                                            ],
                                            "description": "Total quantity of the asset. The value may be returned as a number or a decimal string."
                                        },
                                        "unitCode": {
                                            "type": "string",
                                            "minLength": 1,
                                            "maxLength": 10,
                                            "description": "Unit of measurement code used for the asset."
                                        },
                                        "lineItemNoAsset": {
                                            "type": "integer",
                                            "minimum": 1,
                                            "description": "Asset line item number within the Settlement Asset transaction."
                                        },
                                        "purchaseReferences": {
                                            "type": "array",
                                            "description": "List of saved Good Received purchase references allocated to the asset.",
                                            "minItems": 1,
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "uuidRef": {
                                                        "type": "string",
                                                        "format": "uuid",
                                                        "description": "Unique identifier generated by the system for the purchase reference row."
                                                    },
                                                    "uuid": {
                                                        "type": "string",
                                                        "format": "uuid",
                                                        "description": "Unique identifier of the related asset detail row."
                                                    },
                                                    "uuidHeader": {
                                                        "type": "string",
                                                        "format": "uuid",
                                                        "description": "Unique identifier of the related Settlement Asset transaction header."
                                                    },
                                                    "grpoRef": {
                                                        "type": "string",
                                                        "minLength": 1,
                                                        "maxLength": 50,
                                                        "description": "Good Received transaction number used as the purchase reference."
                                                    },
                                                    "lineItemNoGR": {
                                                        "type": "integer",
                                                        "minimum": 1,
                                                        "description": "Line item number of the referenced Good Received transaction."
                                                    },
                                                    "referenceQty": {
                                                        "type": [
                                                            "number",
                                                            "string"
                                                        ],
                                                        "description": "Quantity allocated from the referenced Good Received detail line."
                                                    }
                                                },
                                                "required": [
                                                    "uuidRef",
                                                    "uuid",
                                                    "uuidHeader",
                                                    "grpoRef",
                                                    "lineItemNoGR",
                                                    "referenceQty"
                                                ],
                                                "additionalProperties": false
                                            }
                                        }
                                    },
                                    "required": [
                                        "uuid",
                                        "uuidHeader",
                                        "itemCodeAsset",
                                        "assetQty",
                                        "unitCode",
                                        "lineItemNoAsset",
                                        "purchaseReferences"
                                    ],
                                    "additionalProperties": false
                                }
                            }
                        },
                        "required": [
                            "uuidHeader",
                            "transactionNo",
                            "transactionDate",
                            "assets"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": [
                "status",
                "message",
                "data"
            ],
            "additionalProperties": false
        },
        {
            "title": "General Error Response",
            "description": "Response returned when validation, duplicate data, reference validation, or server errors occur.",
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "error"
                    ],
                    "description": "Response status indicating that the request could not be processed."
                },
                "message": {
                    "type": "string",
                    "description": "General error message."
                },
                "errors": {
                    "type": [
                        "object",
                        "array",
                        "string",
                        "null"
                    ],
                    "description": "Detailed validation or processing error information."
                }
            },
            "required": [
                "status",
                "message",
                "errors"
            ],
            "additionalProperties": false
        }
    ],
    "examples": [
        {
            "status": "success",
            "message": "Data Settlement Asset successfully saved",
            "data": [
                {
                    "uuidHeader": "e5bbe94c-09f4-4935-a39c-35d8a7250203",
                    "transactionNo": "ASSET/00001",
                    "transactionDate": "2026-08-05",
                    "assets": [
                        {
                            "uuid": "32f6dda9-c523-4920-8e9a-c6f3c5fca39c",
                            "uuidHeader": "e5bbe94c-09f4-4935-a39c-35d8a7250203",
                            "itemCodeAsset": "ASSET0001",
                            "assetQty": 1,
                            "unitCode": "KG",
                            "lineItemNoAsset": 10,
                            "purchaseReferences": [
                                {
                                    "uuidRef": "36ae690e-daad-4c40-91ef-e2dc4d7b4e8a",
                                    "uuid": "32f6dda9-c523-4920-8e9a-c6f3c5fca39c",
                                    "uuidHeader": "e5bbe94c-09f4-4935-a39c-35d8a7250203",
                                    "grpoRef": "GR/GENERAL/002",
                                    "lineItemNoGR": 10,
                                    "referenceQty": 1
                                },
                                {
                                    "uuidRef": "90417bb2-d1de-4ef2-9c7b-3109056d8f54",
                                    "uuid": "32f6dda9-c523-4920-8e9a-c6f3c5fca39c",
                                    "uuidHeader": "e5bbe94c-09f4-4935-a39c-35d8a7250203",
                                    "grpoRef": "GR/GENERAL/002",
                                    "lineItemNoGR": 20,
                                    "referenceQty": 1
                                }
                            ]
                        },
                        {
                            "uuid": "b87b4076-a01c-4824-b5f6-6e60c3dd5139",
                            "uuidHeader": "e5bbe94c-09f4-4935-a39c-35d8a7250203",
                            "itemCodeAsset": "ASSET0001",
                            "assetQty": 1,
                            "unitCode": "KG",
                            "lineItemNoAsset": 20,
                            "purchaseReferences": [
                                {
                                    "uuidRef": "b1eb0be0-978e-4924-aaf7-88a701cd279e",
                                    "uuid": "b87b4076-a01c-4824-b5f6-6e60c3dd5139",
                                    "uuidHeader": "e5bbe94c-09f4-4935-a39c-35d8a7250203",
                                    "grpoRef": "GR/GENERAL/002",
                                    "lineItemNoGR": 10,
                                    "referenceQty": 1
                                },
                                {
                                    "uuidRef": "83d29900-8775-4b41-8885-5c2ac399b069",
                                    "uuid": "b87b4076-a01c-4824-b5f6-6e60c3dd5139",
                                    "uuidHeader": "e5bbe94c-09f4-4935-a39c-35d8a7250203",
                                    "grpoRef": "GR/GENERAL/002",
                                    "lineItemNoGR": 20,
                                    "referenceQty": 1
                                }
                            ]
                        }
                    ]
                },
                {
                    "uuidHeader": "98b9334e-adb1-4885-9096-332d6f461d58",
                    "transactionNo": "ASSET/00002",
                    "transactionDate": "2026-08-05",
                    "assets": [
                        {
                            "uuid": "c9ec1c20-e9c0-4cfb-8923-bc761e8ce9a6",
                            "uuidHeader": "98b9334e-adb1-4885-9096-332d6f461d58",
                            "itemCodeAsset": "ASSET0001",
                            "assetQty": 1,
                            "unitCode": "KG",
                            "lineItemNoAsset": 10,
                            "purchaseReferences": [
                                {
                                    "uuidRef": "8b65738b-884b-44a0-966d-6766f6a08297",
                                    "uuid": "c9ec1c20-e9c0-4cfb-8923-bc761e8ce9a6",
                                    "uuidHeader": "98b9334e-adb1-4885-9096-332d6f461d58",
                                    "grpoRef": "GR/GENERAL/002",
                                    "lineItemNoGR": 10,
                                    "referenceQty": 1
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "status": "error",
            "message": "Validation failed",
            "errors": {
                "data.0.assets.0.purchaseReferences": [
                    "The total reference quantity must not exceed the asset quantity."
                ]
            }
        }
    ]
}