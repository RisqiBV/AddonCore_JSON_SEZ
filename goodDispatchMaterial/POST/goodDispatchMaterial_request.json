{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Good Dispatch Material Request Schema",
  "description": "JSON contract for Good Dispatch Material data. One object represents a single dispatch transaction with header and detail lines.",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "description": "Good Dispatch Material header section.",
      "properties": {
        "transactionNo": {
          "type": "string",
          "maxLength": 50,
          "description": "Primary transaction number."
        },
        "transactionDate": {
          "type": "string",
          "description": "Dispatch transaction date. Expected format: DD-MM-YYYY."
        },
        "dispatchTo": {
          "type": "string",
          "maxLength": 50,
          "description": "Dispatch destination, for example Production or Supplier."
        },
        "deliveryNoteNo": {
          "type": ["string", "null"],
          "maxLength": 50,
          "description": "Delivery note number."
        },
        "bcCode": {
          "type": ["string", "null"],
          "maxLength": 10,
          "description": "BC customs document code."
        },
        "bcNo": {
          "type": ["string", "null"],
          "maxLength": 10,
          "description": "BC customs document number."
        },
        "bcDate": {
          "type": ["string", "null"],
          "description": "BC customs document date. Expected format: DD-MM-YYYY."
        },
        "deliverTo": {
          "type": ["string", "null"],
          "maxLength": 200,
          "description": "Receiver name or destination address."
        },
        "vehicleID": {
          "type": ["string", "null"],
          "maxLength": 50,
          "description": "Vehicle plate number or vehicle ID."
        }
      },
      "required": [
        "transactionNo",
        "transactionDate",
        "dispatchTo"
      ],
      "additionalProperties": false
    },
    "details": {
      "type": "array",
      "description": "Good Dispatch Material detail lines.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "orderNo": {
            "type": "string",
            "maxLength": 25,
            "description": "Related order number."
          },
          "itemCode": {
            "type": "string",
            "maxLength": 50,
            "description": "Material or item code."
          },
          "qty": {
            "type": "number",
            "description": "Quantity. Database type: decimal(18,4)."
          },
          "unitCode": {
            "type": "string",
            "maxLength": 10,
            "description": "Unit of measure code."
          },
          "nw": {
            "type": ["number", "null"],
            "description": "Net weight."
          },
          "gw": {
            "type": ["number", "null"],
            "description": "Gross weight."
          },
          "batchNo": {
            "type": ["string", "null"],
            "maxLength": 10,
            "description": "Batch number."
          },
          "movementType": {
            "type": "string",
            "maxLength": 10,
            "description": "Movement type."
          },
          "reference": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "Reference number or reference information."
          },
          "lineItemNo": {
            "type": "number",
            "description": "Line item number."
          },
          "lineItemNoRef": {
            "type": ["number", "null"],
            "description": "Reference line item number."
          },
          "debitCredit": {
            "type": "string",
            "maxLength": 10,
            "description": "Debit or credit indicator."
          }
        },
        "required": [
          "orderNo",
          "itemCode",
          "qty",
          "unitCode",
          "movementType",
          "lineItemNo",
          "debitCredit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "header",
    "details"
  ],
  "additionalProperties": false,
  "payloadExamples": [
    {
      "header": {
        "transactionNo": "GDM/2026/0001",
        "transactionDate": "15-05-2026",
        "dispatchTo": "Production",
        "deliveryNoteNo": null,
        "bcCode": null,
        "bcNo": null,
        "bcDate": null,
        "deliverTo": null,
        "vehicleID": null
      },
      "details": [
        {
          "orderNo": "ADDON/ORDER/0001/V/2026",
          "itemCode": "Rawmaterial001",
          "qty": 5,
          "unitCode": "KGM",
          "nw": null,
          "gw": null,
          "batchNo": null,
          "movementType": "OUT",
          "reference": null,
          "lineItemNo": 1,
          "lineItemNoRef": null,
          "debitCredit": "CREDIT"
        },
        {
          "orderNo": "ADDON/ORDER/0001/V/2026",
          "itemCode": "Rawmaterial002",
          "qty": 10,
          "unitCode": "KGM",
          "nw": 10,
          "gw": 10.5,
          "batchNo": "BATCH001",
          "movementType": "OUT",
          "reference": "MR/2026/0001",
          "lineItemNo": 2,
          "lineItemNoRef": 1,
          "debitCredit": "CREDIT"
        }
      ]
    },
    {
      "header": {
        "transactionNo": "GDM/2026/0002",
