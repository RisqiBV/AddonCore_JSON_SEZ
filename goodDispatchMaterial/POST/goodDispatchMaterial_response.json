{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Good Dispatch Material Response Schema",
  "description": "JSON response contract for Good Dispatch Material API.",
  "oneOf": [
    {
      "title": "Success Response",
      "description": "Response returned when Good Dispatch Material data is successfully saved.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "Success message."
        },
        "data": {
          "type": "array",
          "description": "Saved Good Dispatch Material data.",
          "items": {
            "type": "object",
            "properties": {
              "header": {
                "type": "object",
                "description": "Saved Good Dispatch Material header data.",
                "properties": {
                  "uuidHeader": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Unique identifier generated by the system for transaction header."
                  },
                  "transactionNo": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Primary transaction number."
                  },
                  "transactionDate": {
                    "type": "string",
                    "description": "Dispatch transaction date. Format: DD-MM-YYYY."
                  },
                  "dispatchTo": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Dispatch destination."
                  },
                  "remark": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "Additional Remark."
                  },
                  "deliveryNoteNo": {
                    "type": ["string", "null"],
                    "maxLength": 50,
                    "description": "Delivery note number."
                  },
                  "bcCode": {
                    "type": ["string", "null"],
                    "maxLength": 10,
                    "description": "BC customs document code."
                  },
                  "bcNo": {
                    "type": ["string", "null"],
                    "maxLength": 10,
                    "description": "BC customs document number."
                  },
                  "bcDate": {
                    "type": ["string", "null"],
                    "description": "BC customs document date. Format: DD-MM-YYYY."
                  },
                  "deliverTo": {
                    "type": ["string", "null"],
                    "maxLength": 200,
                    "description": "Receiver name or destination address."
                  },
                  "vehicleID": {
                    "type": ["string", "null"],
                    "maxLength": 50,
                    "description": "Vehicle plate number or vehicle ID."
                  }
                },
                "required": [
                  "uuidHeader",
                  "transactionNo",
                  "transactionDate",
                  "dispatchTo",
                  "deliveryNoteNo",
                  "bcCode",
                  "bcNo",
                  "bcDate",
                  "deliverTo",
                  "vehicleID"
                ],
                "additionalProperties": false
              },
              "details": {
                "type": "array",
                "description": "Saved Good Dispatch Material detail data.",
                "items": {
                  "type": "object",
                  "properties": {
                    "uuid": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier generated by the system for transaction detail."
                    },
                    "uuidHeader": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier of the related transaction header."
                    },
                    "orderNo": {
                      "type": "string",
                      "maxLength": 25,
                      "description": "Related order number."
                    },
                    "itemCode": {
                      "type": "string",
                      "maxLength": 50,
                      "description": "Material or item code."
                    },
                    "qty": {
                      "type": ["number", "string"],
                      "description": "Quantity. Database type: decimal(18,4)."
                    },
                    "unitCode": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Unit of measure code."
                    },
                    "nw": {
                      "type": ["number", "null"],
                      "description": "Net weight."
                    },
                    "gw": {
                      "type": ["number", "null"],
                      "description": "Gross weight."
                    },
                    "batchNo": {
                      "type": ["string", "null"],
                      "maxLength": 10,
                      "description": "Batch number."
                    },
                    "movementType": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Movement type."
                    },
                    "reference": {
                      "type": ["string", "null"],
                      "maxLength": 50,
                      "description": "Reference number or reference information."
                    },
                    "lineItemNo": {
                      "type": "number",
                      "description": "Line item number."
                    },
                    "lineItemNoRef": {
                      "type": ["number", "null"],
                      "description": "Reference line item number."
                    },
                    "debitCredit": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Debit or credit indicator."
                    }
                  },
                  "required": [
                    "uuid",
                    "uuidHeader",
                    "orderNo",
                    "itemCode",
                    "qty",
                    "unitCode",
                    "nw",
                    "gw",
                    "batchNo",
                    "movementType",
                    "reference",
                    "lineItemNo",
                    "lineItemNoRef",
                    "debitCredit"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "header",
              "details"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "message", "data"],
      "additionalProperties": false
    },
    {
      "title": "General Error Response",
      "description": "Response returned when validation, duplicate data, related data not found, or server error occurs.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["error"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "General error message."
        },
        "errors": {
          "type": ["object", "null"],
          "description": "Detailed error information. The object key represents the field name or error category.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": ["status", "message", "errors"],
      "additionalProperties": false
    }
  ],
