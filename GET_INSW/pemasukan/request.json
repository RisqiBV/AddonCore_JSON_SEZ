{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET KEK Transaksi Pemasukan Request Schema",
  "description": "Request schema for GET data pemasukan from Portal KEK Addon Beacukai Report. This endpoint uses headers and optional query parameters. No JSON body is required.",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "enum": ["GET"],
      "description": "HTTP method."
    },
    "endpoint": {
      "type": "string",
      "enum": [
        "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pemasukan"
      ],
      "description": "GET endpoint URL for KEK transaksi pemasukan."
    },
    "headers": {
      "type": "object",
      "description": "Required authentication headers.",
      "properties": {
        "x-addon-key": {
          "type": "string",
          "description": "Addon API key."
        },
        "x-addon-unique-key": {
          "type": "string",
          "description": "Addon unique key for company/client."
        }
      },
      "required": [
        "x-addon-key",
        "x-addon-unique-key"
      ],
      "additionalProperties": false
    },
    "queryParams": {
      "type": "object",
      "description": "Optional query parameters for filtering pemasukan data. All returned fields can be used as filter parameters.",
      "properties": {
        "uuidheader": {
          "type": "string",
          "maxLength": 100,
          "description": "Filter by UUID header transaction."
        },
        "idtransaksi": {
          "type": "string",
          "maxLength": 100,
          "description": "Filter by transaction ID."
        },
        "nomordokkegiatan": {
          "type": "string",
          "maxLength": 100,
          "description": "Filter by nomor dokumen kegiatan. Example: AFI-GR.01-2026."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Filter by exact created timestamp. Example: 2026-06-15T06:34:55.000000Z."
        },
        "sent_at": {
          "type": "string",
          "format": "date-time",
          "description": "Filter by exact sent timestamp. Example: 2026-06-15T06:34:55.000000Z."
        },
        "sent_at_from": {
          "type": "string",
          "format": "date-time",
          "description": "Filter by sent timestamp start range. Returns data where sent_at is greater than or equal to this value. Example: 2026-06-01T00:00:00.000000Z."
        },
        "sent_at_to": {
          "type": "string",
          "format": "date-time",
          "description": "Filter by sent timestamp end range. Returns data where sent_at is less than or equal to this value. Example: 2026-06-30T23:59:59.000000Z."
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "method",
    "endpoint",
    "headers"
  ],
  "additionalProperties": false,

  "request examples": [
    {
      "description": "GET all data pemasukan.",
      "method": "GET",
      "endpoint": "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pemasukan",
      "headers": {
        "x-addon-key": "<ADDON_KEY>",
        "x-addon-unique-key": "<ADDON_UNIQUE_KEY>"
      },
      "queryParams": {}
    },
    {
      "description": "GET data pemasukan by nomor dokumen kegiatan.",
      "method": "GET",
      "endpoint": "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pemasukan",
      "headers": {
        "x-addon-key": "<ADDON_KEY>",
        "x-addon-unique-key": "<ADDON_UNIQUE_KEY>"
      },
      "queryParams": {
        "nomordokkegiatan": "AFI-GR.01-2026"
      }
    },
    {
      "description": "GET data pemasukan by created_at.",
      "method": "GET",
      "endpoint": "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pemasukan",
      "headers": {
        "x-addon-key": "<ADDON_KEY>",
        "x-addon-unique-key": "<ADDON_UNIQUE_KEY>"
      },
      "queryParams": {
        "created_at": "2026-06-15T06:34:55.000000Z"
      }
    },
    {
      "description": "GET data pemasukan by exact sent_at.",
      "method": "GET",
      "endpoint": "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pemasukan",
      "headers": {
        "x-addon-key": "<ADDON_KEY>",
        "x-addon-unique-key": "<ADDON_UNIQUE_KEY>"
      },
      "queryParams": {
        "sent_at": "2026-06-15T06:34:55.000000Z"
      }
    },
    {
      "description": "GET data pemasukan by sent_at range.",
      "method": "GET",
      "endpoint": "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pemasukan",
      "headers": {
        "x-addon-key": "<ADDON_KEY>",
        "x-addon-unique-key": "<ADDON_UNIQUE_KEY>"
      },
      "queryParams": {
        "sent_at_from": "2026-06-01T00:00:00.000000Z",
        "sent_at_to": "2026-06-30T23:59:59.000000Z"
      }
    },
    {
      "description": "GET data pemasukan sent after or equal to sent_at_from.",
      "method": "GET",
      "endpoint": "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pemasukan",
      "headers": {
        "x-addon-key": "<ADDON_KEY>",
        "x-addon-unique-key": "<ADDON_UNIQUE_KEY>"
      },
      "queryParams": {
        "sent_at_from": "2026-06-01T00:00:00.000000Z"
      }
    },
    {
      "description": "GET data pemasukan sent before or equal to sent_at_to.",
      "method": "GET",
      "endpoint": "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pemasukan",
      "headers": {
        "x-addon-key": "<ADDON_KEY>",
        "x-addon-unique-key": "<ADDON_UNIQUE_KEY>"
      },
      "queryParams": {
        "sent_at_to": "2026-06-30T23:59:59.000000Z"
      }
    }
  ]
}