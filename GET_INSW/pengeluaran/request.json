{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET KEK Transaksi Pengeluaran Request Schema",
  "description": "Request schema for GET data pengeluaran from Portal KEK Addon Beacukai Report. This endpoint uses headers and optional query parameters. No JSON body is required.",
  "type": "object",
  "properties": {
    "method": {
      "type": "string",
      "enum": ["GET"],
      "description": "HTTP method."
    },
    "endpoint": {
      "type": "string",
      "enum": [
        "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pengeluaran"
      ],
      "description": "GET endpoint URL for KEK transaksi pengeluaran."
    },
    "headers": {
      "type": "object",
      "description": "Required authentication headers.",
      "properties": {
        "x-addon-key": {
          "type": "string",
          "description": "Addon API key."
        },
        "x-addon-unique-key": {
          "type": "string",
          "description": "Addon unique key for company/client."
        }
      },
      "required": [
        "x-addon-key",
        "x-addon-unique-key"
      ],
      "additionalProperties": false
    },
    "queryParams": {
      "type": "object",
      "description": "Optional query parameters for filtering pengeluaran data. All returned fields can be used as filter parameters.",
      "properties": {
        "uuidheader": {
          "type": "string",
          "maxLength": 100,
          "description": "Filter by UUID header transaction. Example: fbd25d88-8fa3-42ae-a9cb-83426d0d8a4e."
        },
        "idtransaksi": {
          "type": "string",
          "maxLength": 100,
          "description": "Filter by transaction ID."
        },
        "nomordokkegiatan": {
          "type": "string",
          "maxLength": 100,
          "description": "Filter by nomor dokumen kegiatan. Example: GDM/2038/0001."
        },
        "created_at": {
          "type": "string",
          "description": "Filter by created timestamp. Example: 2026-06-17T03:48:04.000000Z."
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "method",
    "endpoint",
    "headers"
  ],
  "additionalProperties": false,

  "request examples": [
    {
      "description": "GET all data pengeluaran.",
      "method": "GET",
      "endpoint": "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pengeluaran",
      "headers": {
        "x-addon-key": "<ADDON_KEY>",
        "x-addon-unique-key": "<ADDON_UNIQUE_KEY>"
      },
      "queryParams": {}
    },
    {
      "description": "GET data pengeluaran by nomor dokumen kegiatan.",
      "method": "GET",
      "endpoint": "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pengeluaran",
      "headers": {
        "x-addon-key": "<ADDON_KEY>",
        "x-addon-unique-key": "<ADDON_UNIQUE_KEY>"
      },
      "queryParams": {
        "nomordokkegiatan": "GDM/2038/0001"
      }
    },
    {
      "description": "GET data pengeluaran by uuidheader.",
      "method": "GET",
      "endpoint": "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pengeluaran",
      "headers": {
        "x-addon-key": "<ADDON_KEY>",
        "x-addon-unique-key": "<ADDON_UNIQUE_KEY>"
      },
      "queryParams": {
        "uuidheader": "fbd25d88-8fa3-42ae-a9cb-83426d0d8a4e"
      }
    },
    {
      "description": "GET data pengeluaran by created_at.",
      "method": "GET",
      "endpoint": "https://kek.addonbeacukaireport.com/api/get/kek-transaksi/pengeluaran",
      "headers": {
        "x-addon-key": "<ADDON_KEY>",
        "x-addon-unique-key": "<ADDON_UNIQUE_KEY>"
      },
      "queryParams": {
        "created_at": "2026-06-17T03:48:04.000000Z"
      }
    }
  ]
}
