{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET KEK Transaksi Pengeluaran Response Schema",
  "description": "Response schema for GET data pengeluaran from Portal KEK Addon Beacukai Report.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "error"],
      "description": "Response status."
    },
    "message": {
      "type": "string",
      "description": "Response message from API."
    },
    "data_type": {
      "type": "string",
      "enum": ["pengeluaran"],
      "description": "Transaction data type returned by endpoint."
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Total data returned."
    },
    "data": {
      "type": "array",
      "description": "List of pengeluaran transaction data.",
      "items": {
        "type": "object",
        "properties": {
          "uuidheader": {
            "type": ["string", "null"],
            "maxLength": 100,
            "description": "UUID header transaction. Value can be null if not available."
          },
          "idtransaksi": {
            "type": ["string", "null"],
            "maxLength": 100,
            "description": "Transaction ID. Value can be null if transaction has not been sent or has no response ID."
          },
          "nomordokkegiatan": {
            "type": ["string", "null"],
            "maxLength": 100,
            "description": "Nomor dokumen kegiatan pengeluaran."
          },
          "created_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Created timestamp from API/database. Value can be null if not available. Example: 2026-06-17T03:48:04.000000Z."
          },
          "sent_at": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "Sent timestamp when transaction data was sent to the related system/API. Value can be null if the transaction has not been sent. Example: 2026-06-17T04:15:22.000000Z."
          }
        },
        "required": [
          "uuidheader",
          "idtransaksi",
          "nomordokkegiatan",
          "created_at",
          "sent_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "status",
    "message",
    "data_type",
    "total",
    "data"
  ],
  "additionalProperties": false,

  "response examples": [
    {
      "description": "Success response with sent_at value.",
      "response": {
        "status": "success",
        "message": "Transaction data retrieved successfully",
        "data_type": "pengeluaran",
        "total": 1,
        "data": [
          {
            "uuidheader": "fbd25d88-8fa3-42ae-a9cb-83426d0d8a4e",
            "idtransaksi": "TRX-KEK-202606170001",
            "nomordokkegiatan": "GDM/2038/0001",
            "created_at": "2026-06-17T03:48:04.000000Z",
            "sent_at": "2026-06-17T04:15:22.000000Z"
          }
        ]
      }
    },
    {
      "description": "Success response with null sent_at when transaction has not been sent.",
      "response": {
        "status": "success",
        "message": "Transaction data retrieved successfully",
        "data_type": "pengeluaran",
        "total": 1,
        "data": [
          {
            "uuidheader": "fbd25d88-8fa3-42ae-a9cb-83426d0d8a4e",
            "idtransaksi": null,
            "nomordokkegiatan": "GDM/2038/0001",
            "created_at": "2026-06-17T03:48:04.000000Z",
            "sent_at": null
          }
        ]
      }
    },
    {
      "description": "Success response with empty data.",
      "response": {
        "status": "success",
        "message": "Transaction data retrieved successfully",
        "data_type": "pengeluaran",
        "total": 0,
        "data": []
      }
    },
    {
      "description": "Error response example.",
      "response": {
        "status": "error",
        "message": "Unauthorized request",
        "data_type": "pengeluaran",
        "total": 0,
        "data": []
      }
    }
  ]
}