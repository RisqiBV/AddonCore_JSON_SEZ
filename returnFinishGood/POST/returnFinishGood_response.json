                      "type": ["string", "null"],
                      "maxLength": 250
                    },
                    "sizeFinishGoodCode": {
                      "type": ["string", "null"],
                      "maxLength": 10
                    },
                    "qty": {
                      "type": ["number", "string"],
                      "description": "Returned quantity."
                    },
                    "giReference": {
                      "type": "string",
                      "maxLength": 50,
                      "description": "Related Goods Issue transaction number."
                    },
                    "lineItemNoGiReference": {
                      "type": ["number", "string"],
                      "description": "Line item number in the referenced Goods Issue transaction."
                    },
                    "lineItemNo": {
                      "type": ["number", "string"],
                      "description": "Return transaction line item number."
                    },
                    "movementType": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Movement type. Example: IN."
                    },
                    "reference": {
                      "type": ["string", "null"],
                      "maxLength": 50
                    },
                    "lineItemNoRef": {
                      "type": ["number", "string", "null"]
                    },
                    "debitCredit": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Debit/Credit indicator. Example: DEBIT or CREDIT."
                    }
                  },
                  "required": [
                    "uuid",
                    "uuidHeader",
                    "orderNo",
                    "colorFinishGood",
                    "sizeFinishGoodCode",
                    "qty",
                    "giReference",
                    "lineItemNoGiReference",
                    "lineItemNo",
                    "movementType",
                    "debitCredit"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "header",
              "details"
            ],
            "additionalProperties": false
