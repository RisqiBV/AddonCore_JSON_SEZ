{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order BOM Schema",
  "description": "JSON contract for Bill of Material for each order line, including timestamps.",
  "type": "object",
  "properties": {
    "orderNO": {
      "type": "string",
      "maxLength": 25,
      "description": "Production Order number (PRO No)."
    },
    "materialCode": {
      "type": "string",
      "maxLength": 50,
      "description": "Material ItemCode."
    },
    "colorFinishGood": {
      "type": "string",
      "maxLength": 250,
      "description": "Finish good color."
    },
    "sizeFinishGoodCode": {
      "type": "string",
      "maxLength": 10,
      "description": "Finish good size code."
    },
    "orderQty": {
      "type": "number",
      "description": "Quantity ordered of the finished good."
    },
    "consumption": {
      "type": "number",
      "multipleOf": 0.00001,
      "description": "Material consumption per unit (numeric(18,5))."
    },
    "unitCode": {
      "type": "string",
      "maxLength": 10,
      "description": "Unit code of the material."
    },
    "lineItemNo": {
      "type": "number",
      "description": "lineItemNo on SAP"
    }
  },
  "required": [
      "orderNO", "materialCode",
      "colorFinishGood", "sizeFinishGoodCode", "orderQty", 
      "consumption", "unitCode","lineItemNo"],
  "additionalProperties": false,
 
  "payload examples": [
      {
      "orderNO": "ADDON/SO/1",
      "materialCode": "Rawmaterial001",
      "colorFinishGood": "Black",
      "sizeFinishGoodCode": "XL",
      "orderQty": 100,
      "consumption": 0.2,
      "unitCode": "KGM",
      "lineItemNo": 10
      }
  ]
}