{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BOM Response Schema",
  "description": "JSON response contract for Bill of Material API.",
  "oneOf": [
    {
      "title": "Success Response",
      "description": "Response returned when BOM data is successfully saved.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "Success message."
        },
        "data": {
          "type": "array",
          "description": "Saved BOM data.",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuid",
                "description": "Unique identifier generated by the system."
              },
              "orderNO": {
                "type": "string",
                "maxLength": 25,
                "description": "Production Order number."
              },
              "materialCode": {
                "type": "string",
                "maxLength": 50,
                "description": "Material item code."
              },
              "colorFinishGood": {
                "type": "string",
                "maxLength": 250,
                "description": "Finish good color."
              },
              "sizeFinishGoodCode": {
                "type": "string",
                "maxLength": 10,
                "description": "Finish good size code."
              },
              "orderQty": {
                "type": "number",
                "description": "Quantity ordered of the finished good."
              },
              "consumption": {
                "type": "number",
                "multipleOf": 0.00001,
                "description": "Material consumption per unit."
              },
              "unitCode": {
                "type": "string",
                "maxLength": 10,
                "description": "Unit code of the material."
              },
              "lineItemNo": {
                "type": ["number", "null"],
                "description": "Line item number from SAP."
              }
            },
            "required": [
              "uuid",
              "orderNO",
              "materialCode",
              "colorFinishGood",
              "sizeFinishGoodCode",
              "orderQty",
              "consumption",
              "unitCode",
              "lineItemNo"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "message", "data"],
      "additionalProperties": false
    },
    {
      "title": "General Error Response",
      "description": "Response returned when validation, duplicate data, related data not found, or server error occurs.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["error"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "General error message."
        },
        "errors": {
          "type": ["object", "null"],
          "description": "Detailed error information. The object key represents the field name or error category.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": ["status", "message", "errors"],
      "additionalProperties": false
    }
  ],
  "responseExamples": {
    "success": {
      "status": "success",
      "message": "Data BOM successfully saved",
      "data": [
        {
          "uuid": "6bad93a8-2a9b-463f-9ba1-b0acc5ad7d66",
          "orderNO": "ADDON/SO/1",
          "materialCode": "Rawmaterial001",
          "colorFinishGood": "Black",
          "sizeFinishGoodCode": "XL",
          "orderQty": 100,
          "consumption": 0.2,
          "unitCode": "KGM",
          "lineItemNo": null
        }
      ]
    },
    "validationError": {
      "status": "error",
      "message": "Validation failed",
      "errors": {
        "orderNO": [
          "The orderNO field is required."
        ],
        "materialCode": [
          "The materialCode field is required."
        ],
        "orderQty": [
          "The orderQty must be a number."
        ],
        "consumption": [
          "The consumption must be a number."
        ],
        "unitCode": [
          "The unitCode field is required."
        ]
      }
    },
    "duplicateError": {
      "status": "error",
      "message": "Duplicate data found",
      "errors": {
        "duplicate": [
          "The submitted BOM data already exists."
        ]
      }
    },
    "relatedDataNotFoundError": {
      "status": "error",
      "message": "Related data not found",
      "errors": {
        "orderNO": [
          "Sales Order data with the specified orderNO was not found."
        ],
        "materialCode": [
          "Item Master data with the specified materialCode was not found."
        ],
        "unitCode": [
          "Unit Master data with the specified unitCode was not found."
        ]
      }
    },
    "serverError": {
      "status": "error",
      "message": "Internal server error",
      "errors": null
    }
  }
}