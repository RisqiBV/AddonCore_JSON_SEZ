{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Delete Order BOM Response Schema",
  "description": "JSON response contract for deleting Bill of Material data.",
  "oneOf": [
    {
      "title": "Success Response",
      "description": "Response returned when Bill of Material data is successfully deleted.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "Success message."
        },
        "data": {
          "type": "object",
          "description": "Deleted Bill of Material reference data.",
          "properties": {
            "uuid": {
              "type": "string",
              "format": "uuid",
              "description": "Unique identifier of deleted Bill of Material data."
            },
            "deletedAt": {
              "type": "string",
              "format": "date-time",
              "description": "Date and time when the data was deleted."
            }
          },
          "required": ["uuid", "deletedAt"],
          "additionalProperties": false
        }
      },
      "required": ["status", "message", "data"],
      "additionalProperties": false
    },
    {
      "title": "General Error Response",
      "description": "Response returned when validation, not found, or server error occurs.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["error"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "General error message."
        },
        "errors": {
          "type": ["object", "null"],
          "description": "Detailed error information. The object key represents the field name or error category.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": ["status", "message", "errors"],
      "additionalProperties": false
    }
  ],
  "responseExamples": {
    "success": {
      "status": "success",
      "message": "Data BOM successfully deleted",
      "data": {
        "uuid": "5a094b32-5009-43f6-a44d-f50b9713c4ed",
        "deletedAt": "2026-05-10T02:44:14.018020Z"
      }
    },
    "validationError": {
      "status": "error",
      "message": "Validation failed",
      "errors": {
        "uuid": [
          "The uuid field is required.",
          "The uuid must be a valid UUID."
        ]
      }
    },
    "notFoundError": {
      "status": "error",
      "message": "Data BOM not found",
      "errors": {
        "uuid": [
          "Bill of Material data with the specified uuid was not found."
        ]
      }
    },
    "serverError": {
      "status": "error",
      "message": "Internal server error",
      "errors": null
    }
  }
}