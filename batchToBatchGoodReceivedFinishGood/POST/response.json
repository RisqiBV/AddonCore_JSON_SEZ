{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Batch To Batch Good Received Finish Good Response Schema",
  "description": "Response schema for Batch To Batch Good Received Finish Good API",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "error"],
      "description": "Response status"
    },
    "message": {
      "type": "string",
      "description": "Response message"
    },
    "data": {
      "type": ["array", "null"],
      "description": "Array of processed batch-to-batch transactions",
      "items": {
        "type": "object",
        "properties": {
          "header": {
            "type": "object",
            "description": "Transaction header",
            "properties": {
              "uuidHeader": {
                "type": "string",
                "format": "uuid"
              },
              "transactionNo": {
                "type": "string",
                "maxLength": 50
              },
              "transactionDate": {
                "type": "string",
                "description": "Transaction date in DD-MM-YYYY format"
              }
            },
            "required": [
              "uuidHeader",
              "transactionNo",
              "transactionDate"
            ],
            "additionalProperties": false
          },
          "details": {
            "type": "array",
            "description": "Transaction details",
            "items": {
              "type": "object",
              "properties": {
                "uuid": {
                  "type": "string",
                  "format": "uuid"
                },
                "uuidHeader": {
                  "type": "string",
                  "format": "uuid"
                },
                "itemCode": {
                  "type": "string",
                  "maxLength": 50
                },
                "sourceBatch": {
                  "type": "string",
                  "maxLength": 10
                },
                "updatedBatch": {
                  "type": "string",
                  "maxLength": 10
                },
                "qty": {
                  "type": ["number", "string"],
                  "description": "Quantity moved from source to updated batch"
                }
              },
              "required": [
                "uuid",
                "uuidHeader",
                "itemCode",
                "sourceBatch",
                "updatedBatch",
                "qty"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "header",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": ["object", "null"],
      "description": "Field-specific or general error details",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  },
  "required": [
    "status",
    "message"
  ],
  "additionalProperties": false
}