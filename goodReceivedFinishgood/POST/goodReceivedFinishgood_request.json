{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Good Received Finished Good Request Schema",
  "description": "JSON contract for Good Received Finished Good data. One object represents a single GR-FG transaction with header and detail lines.",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "description": "Good Received Finished Good header section.",
      "properties": {
        "transactionNo": {
          "type": "string",
          "maxLength": 50,
          "description": "Primary transaction number."
        },
        "transactionDate": {
          "type": "string",
          "description": "Transaction date. Expected format: DD-MM-YYYY."
        }
      },
      "required": [
        "transactionNo",
        "transactionDate"
      ],
      "additionalProperties": false
    },
    "details": {
      "type": "array",
      "description": "Good Received Finished Good detail lines.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "orderNo": {
            "type": "string",
            "maxLength": 25,
            "description": "Related order number."
          },
          "poCust": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer PO reference related to order number."
          },
          "colorFinishGood": {
            "type": "string",
            "maxLength": 250,
            "description": "Finished good color."
          },
          "sizeFinishGoodCode": {
            "type": "string",
            "maxLength": 10,
            "description": "Finished good size code."
          },
          "qty": {
            "type": "number",
            "description": "Quantity."
          },
            "batchNo": {
            "type": ["string", "null"],
            "maxLength": 10,
            "description": "Batch number."
          },
          "itemCode": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "Finished good item code."
          },
          "movementType": {
            "type": "string",
            "maxLength": 10,
            "description": "Movement type."
          },
          "reference": {
            "type": ["string", "null"],
            "maxLength": 50,
            "description": "Reference number or reference information."
          },
          "lineItemNo": {
            "type": "number",
            "description": "Line item number."
          },
          "lineItemNoRef": {
            "type": ["number", "null"],
            "description": "Reference line item number."
          },
          "debitCredit": {
            "type": "string",
            "maxLength": 10,
            "description": "Debit or credit indicator."
          }
        },
        "required": [
          "orderNo",
          "poCust",
          "colorFinishGood",
          "sizeFinishGoodCode",
          "qty",
          "movementType",
          "lineItemNo",
          "debitCredit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "header",
    "details"
  ],
  "additionalProperties": false,
  "payloadExamples": [
    {
      "header": {
        "transactionNo": "GRFG/2026/0001",
        "transactionDate": "15-05-2026"
      },
      "details": [
        {
          "orderNo": "ADDON/ORDER/0001/V/2026",
          "poCust": "CUSTOMER/PO-1",
          "colorFinishGood": "Black",
          "sizeFinishGoodCode": "M",
          "qty": 10,
          "batchNo": "BATCH001",
          "itemCode": "FG-001",
          "movementType": "IN",
          "reference": null,
          "lineItemNo": 1,
          "lineItemNoRef": null,
          "debitCredit": "DEBIT"
        },
        {
          "orderNo": "ADDON/ORDER/0001/V/2026",
          "poCust": "CUSTOMER/PO-2",
          "colorFinishGood": "Black",
          "sizeFinishGoodCode": "L",
          "qty": 12.1256,
          "batchNo": "",
          "itemCode": "FG-002",
          "movementType": "IN",
          "reference": "PROD/2026/0001",
          "lineItemNo": 2,
          "lineItemNoRef": 1,
          "debitCredit": "DEBIT"
        }
      ]
    }
  ]
}