{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Purchase Order Material PUT Schema",
  "description": "JSON contract for updating Purchase Order Material data by uuidHeader. This endpoint supports header update, existing detail update by uuid, new detail insertion when uuid is not provided, and detail delete/active flag using deleteStatus.",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "List of Purchase Order Material records to be updated.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "header": {
            "type": "object",
            "description": "PO Material header section. uuidHeader is required for update.",
            "properties": {
              "uuidHeader": {
                "type": "string",
                "format": "uuid",
                "description": "Primary key for header update. Required. System will update data only if uuidHeader exists in database."
              },
              "supplierCode": {
                "type": "string",
                "maxLength": 50,
                "description": "Supplier code. Updateable."
              },
              "poDate": {
                "type": "string",
                "description": "PO date. Updateable. Expected format: DD-MM-YYYY."
              },
              "poNo": {
                "type": "string",
                "maxLength": 50,
                "description": "PO number. Not updateable, but must be sent with original value."
              },
              "etdActual": {
                "type": ["string", "null"],
                "description": "ETD Actual. Updateable. Can be null."
              },
              "eta": {
                "type": ["string", "null"],
                "description": "ETA. Updateable. Can be null."
              },
              "fc": {
                "type": "string",
                "maxLength": 15,
                "description": "PO type. Updateable."
              }
            },
            "required": [
              "uuidHeader",
              "supplierCode",
              "poDate",
              "poNo",
              "etdActual",
              "eta",
              "fc"
            ],
            "additionalProperties": false
          },
          "details": {
            "type": "array",
            "description": "Detail material lines. If uuid is provided, the detail will be updated. If uuid is not provided or empty, the detail will be added as a new item. deleteStatus is required to indicate whether the detail should be deleted/disabled.",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "uuid": {
                  "type": ["string", "null"],
                  "format": "uuid",
                  "description": "Detail row key. If provided, update existing detail. If not provided or null, add as new detail."
                },
                "additionalRemarks": {
                  "type": ["string", "null"],
                  "description": "Additional remarks. Updateable. Can be null."
                },
                "orderNo": {
                  "type": "string",
                  "maxLength": 25,
                  "description": "Sales/Production order number. Updateable."
                },
                "itemCode": {
                  "type": "string",
                  "maxLength": 50,
                  "description": "Material item code. Updateable."
                },
                "vendorQty": {
                  "type": "number",
                  "description": "Vendor quantity. Updateable."
                },
                "vendorUnitCode": {
                  "type": "string",
                  "maxLength": 10,
                  "description": "Vendor unit code. Updateable."
                },
                "unitPrice": {
                  "type": "number",
                  "description": "Unit price. Updateable."
                },
                "currency": {
                  "type": "string",
                  "maxLength": 10,
                  "description": "Currency code. Updateable. Example: USD, IDR."
                },
                "lineItemNo": {
                  "type": "number",
                  "description": "Line item number on SAP. Updateable."
                },
                "deleteStatus": {
                  "type": "boolean",
                  "description": "Delete status flag. false means active/not deleted, true means deleted/marked for deletion."
                }
              },
              "required": [
                "additionalRemarks",
                "orderNo",
                "itemCode",
                "vendorQty",
                "vendorUnitCode",
                "unitPrice",
                "currency",
                "lineItemNo",
                "deleteStatus"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "header",
          "details"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "data": [
        {
          "header": {
            "uuidHeader": "f402fc5e-9189-442f-8330-379122ab464a",
            "supplierCode": "SUP005",
            "poDate": "10-08-2026",
            "poNo": "XXPO/KWL/004/2026",
            "etdActual": "10-08-2026",
            "eta": "10/09/2026",
            "fc": "PO"
          },
          "details": [
            {
              "uuid": "d44ed63e-02a6-4989-8543-c6cced55023a",
              "additionalRemarks": "test",
              "orderNo": "ADDON/ORDER/0001/V/2026",
              "itemCode": "RM-001",
              "vendorQty": 126.4,
              "vendorUnitCode": "KG",
              "unitPrice": 110,
              "currency": "USD",
              "lineItemNo": 100,
              "deleteStatus": false
            },
            {
              "uuid": "294b2d8f-0aed-455f-94d7-1f15a213d175",
              "additionalRemarks": "test",
              "orderNo": "ADDON/ORDER/0001/V/2026",
              "itemCode": "RM-001",
              "vendorQty": 127.4,
              "vendorUnitCode": "KG",
              "unitPrice": 120,
              "currency": "USD",
              "lineItemNo": 101,
              "deleteStatus": true
            }
          ]
        }
      ]
    }
  ]
}