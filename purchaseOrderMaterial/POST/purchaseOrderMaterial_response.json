{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Purchase Order Material Response Schema",
  "description": "JSON response contract for Purchase Order Material API.",
  "oneOf": [
    {
      "title": "Success Response",
      "description": "Response returned when Purchase Order Material data is successfully saved.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "Success message."
        },
        "data": {
          "type": "array",
          "description": "Saved Purchase Order Material data.",
          "items": {
            "type": "object",
            "properties": {
              "header": {
                "type": "object",
                "description": "Saved Purchase Order Material header data.",
                "properties": {
                  "uuidHeader": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Unique identifier generated by the system for PO header."
                  },
                  "supplierCode": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Supplier code."
                  },
                  "poDate": {
                    "type": "string",
                    "description": "PO date. Format: DD-MM-YYYY."
                  },
                  "poNo": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "PO number."
                  },
                  "etdActual": {
                    "type": ["string", "null"],
                    "description": "ETD Actual."
                  },
                  "eta": {
                    "type": ["string", "null"],
                    "description": "ETA."
                  },
                  "fc": {
                    "type": "string",
                    "maxLength": 15,
                    "enum": ["PO", "FOC"],
                    "description": "PO type: PO or FOC."
                  }
                },
                "required": [
                  "uuidHeader",
                  "supplierCode",
                  "poDate",
                  "poNo",
                  "etdActual",
                  "eta",
                  "fc"
                ],
                "additionalProperties": false
              },
              "details": {
                "type": "array",
                "description": "Saved Purchase Order Material detail data.",
                "items": {
                  "type": "object",
                  "properties": {
                    "uuid": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier generated by the system for PO detail."
                    },
                    "uuidHeader": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier of the related PO header."
                    },
                    "additionalRemarks": {
                      "type": ["string", "null"],
                      "description": "Additional remarks."
                    },
                    "orderNo": {
                      "type": "string",
                      "maxLength": 25,
                      "description": "Sales or production order number."
                    },
                    "itemCode": {
                      "type": "string",
                      "maxLength": 50,
                      "description": "Material item code."
                    },
                    "vendorQty": {
                      "type": ["number", "string"],
                      "description": "Vendor quantity."
                    },
                    "vendorUnitCode": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Vendor unit code."
                    },
                    "unitPrice": {
                      "type": ["number", "string"],
                      "description": "Unit price."
                    },
                    "currency": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Currency code."
                    },
                    "lineItemNo": {
                      "type": ["number", "null"],
                      "description": "Line item number from SAP."
                    }
                  },
                  "required": [
                    "uuid",
                    "uuidHeader",
                    "additionalRemarks",
                    "orderNo",
                    "itemCode",
                    "vendorQty",
                    "vendorUnitCode",
                    "unitPrice",
                    "currency",
                    "lineItemNo"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "header",
              "details"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "message", "data"],
      "additionalProperties": false
    },
    {
      "title": "General Error Response",
      "description": "Response returned when validation, duplicate data, related data not found, or server error occurs.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["error"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "General error message."
        },
        "errors": {
          "type": ["object", "null"],
          "description": "Detailed error information. The object key represents the field name or error category.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": ["status", "message", "errors"],
      "additionalProperties": false
    }
  ],
  "responseExamples": {
    "success": {
      "status": "success",
      "message": "Data Purchase Order Material successfully saved",
      "data": [
        {
          "header": {
            "uuidHeader": "7ed1ac4c-064d-4ebb-80f2-08ede9a90c73",
            "supplierCode": "ADDON",
            "poDate": "05-05-2026",
            "poNo": "PO/ADDON/I/IV",
            "etdActual": "25-05-2026",
            "eta": "20-05-2026",
            "fc": "PO"
          },
          "details": [
            {
              "uuid": "0ee777cb-358a-471b-b677-7b3f3a864668",
              "uuidHeader": "7ed1ac4c-064d-4ebb-80f2-08ede9a90c73",
              "additionalRemarks": "Remarks",
              "orderNo": "ADDON/ORDER/0001/V/2026",
              "itemCode": "Rawmaterial001",
              "vendorQty": "20.00",
              "vendorUnitCode": "KGM",
              "unitPrice": "1.00000",
              "currency": "USD",
              "lineItemNo": 1
            }
          ]
        }
      ]
    },
    "validationError": {
      "status": "error",
      "message": "Validation failed",
      "errors": {
        "header.supplierCode": [
          "The header.supplierCode field is required."
        ],
        "header.poDate": [
          "The header.poDate field is required."
        ],
        "header.poNo": [
          "The header.poNo field is required."
        ],
        "header.fc": [
          "The header.fc field is required."
        ],
        "details": [
          "The details field is required and must contain at least one item."
        ],
        "details.0.orderNo": [
          "The details.0.orderNo field is required."
        ],
        "details.0.itemCode": [
          "The details.0.itemCode field is required."
        ],
        "details.0.vendorQty": [
          "The details.0.vendorQty must be a number."
        ],
        "details.0.unitPrice": [
          "The details.0.unitPrice must be a number."
        ]
      }
    },
    "duplicateError": {
      "status": "error",
      "message": "Duplicate data found",
      "errors": {
        "duplicate": [
          "The submitted Purchase Order Material data already exists."
        ]
      }
    },
    "relatedDataNotFoundError": {
      "status": "error",
      "message": "Related data not found",
      "errors": {
        "supplierCode": [
          "Supplier Master data with the specified supplierCode was not found."
        ],
        "orderNo": [
          "Sales Order data with the specified orderNo was not found."
        ],
        "itemCode": [
          "Item Master data with the specified itemCode was not found."
        ],
        "vendorUnitCode": [
          "Unit Master data with the specified vendorUnitCode was not found."
        ]
      }
    },
    "serverError": {
      "status": "error",
      "message": "Internal server error",
      "errors": null
    }
  }
}