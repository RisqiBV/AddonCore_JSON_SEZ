{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Purchase Order General PUT Schema",
  "description": "JSON contract for updating Purchase Order General data by uuidHeader. This endpoint supports header update, existing detail update by uuid, new detail insertion when uuid is not provided, and detail delete/active flag using deleteStatus.",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "description": "List of Purchase Order General records to be updated.",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "header": {
            "type": "object",
            "description": "PO header section. uuidHeader is required for update.",
            "properties": {
              "uuidHeader": {
                "type": "string",
                "format": "uuid",
                "description": "Primary key for header update. Required. System will update data only if uuidHeader exists in database."
              },
              "supplierCode": {
                "type": "string",
                "maxLength": 50,
                "description": "Supplier code. Updateable."
              },
              "poDate": {
                "type": "string",
                "description": "PO date. Updateable. Expected format: DD-MM-YYYY."
              },
              "poNo": {
                "type": "string",
                "maxLength": 50,
                "description": "PO number. Not updateable, but must be sent with original value."
              },
              "etdActual": {
                "type": ["string", "null"],
                "description": "ETD Actual. Updateable. Can be null."
              },
              "eta": {
                "type": ["string", "null"],
                "description": "ETA. Updateable. Can be null."
              },
              "fc": {
                "type": "string",
                "maxLength": 15,
                "enum": ["PO", "FOC"],
                "description": "PO type. Updateable. Allowed values: PO or FOC."
              }
            },
            "required": [
              "uuidHeader",
              "supplierCode",
              "poDate",
              "poNo",
              "etdActual",
              "eta",
              "fc"
            ],
            "additionalProperties": false
          },
          "details": {
            "type": "array",
            "description": "Detail item lines. If uuid is provided, the detail will be updated. If uuid is not provided or empty, the detail will be added as a new item. deleteStatus is required to indicate whether the detail should be deleted/disabled.",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "uuid": {
                  "type": ["string", "null"],
                  "format": "uuid",
                  "description": "Detail row key. If provided, update existing detail. If not provided or null, add as new detail."
                },
                "additionalRemarks": {
                  "type": ["string", "null"],
                  "description": "Additional remarks. Updateable. Can be null."
                },
                "itemCode": {
                  "type": "string",
                  "maxLength": 50,
                  "description": "General item code. Updateable."
                },
                "vendorQty": {
                  "type": "number",
                  "description": "Vendor quantity. Updateable. Decimal value."
                },
                "vendorUnitCode": {
                  "type": "string",
                  "maxLength": 10,
                  "description": "Vendor unit code. Updateable."
                },
                "unitPrice": {
                  "type": "number",
                  "description": "Unit price. Updateable. Decimal value."
                },
                "currency": {
                  "type": "string",
                  "maxLength": 10,
                  "description": "Currency code. Updateable. Example: USD, IDR."
                },
                "lineItemNo": {
                  "type": "number",
                  "description": "Line item number on SAP. Updateable."
                },
                "deleteStatus": {
                  "type": "boolean",
                  "description": "Delete status flag. false means active/not deleted, true means deleted/marked for deletion."
                }
              },
              "required": [
                "additionalRemarks",
                "itemCode",
                "vendorQty",
                "vendorUnitCode",
                "unitPrice",
                "currency",
                "lineItemNo",
                "deleteStatus"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "header",
          "details"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false,
  "examples": [
    {
      "data": [
        {
          "header": {
            "uuidHeader": "d715a5b9-e59a-4372-9c97-e9f7dacd4f2c",
            "supplierCode": "ADDON",
            "poDate": "09-05-2026",
            "poNo": "PO/ADDON/I/IV",
            "etdActual": "19-05-2026",
            "eta": "18-05-2026",
            "fc": "PO"
          },
          "details": [
            {
              "uuid": "82607835-77e6-4fd7-8b5c-7f4536db0c0c",
              "additionalRemarks": "Edit Remarks1",
              "itemCode": "MCH1",
              "vendorQty": 1.00,
              "vendorUnitCode": "PCE",
              "unitPrice": 12500000.00000,
              "currency": "IDR",
              "lineItemNo": 10,
              "deleteStatus": false
            },
            {
              "uuid": "718aa6e4-6c14-4824-ae76-2e7fd450673b",
              "additionalRemarks": "Edit Remarks2",
              "itemCode": "MCH2",
              "vendorQty": 1.00,
              "vendorUnitCode": "PCE",
              "unitPrice": 12500000.00000,
              "currency": "IDR",
              "lineItemNo": 11,
              "deleteStatus": true
            },
            {
              "uuid": null,
              "additionalRemarks": "Adding Material",
              "itemCode": "MCH3",
              "vendorQty": 1.00,
              "vendorUnitCode": "PCE",
              "unitPrice": 900000.00000,
              "currency": "IDR",
              "lineItemNo": 12,
              "deleteStatus": false
            }
          ]
        }
      ]
    }
  ]
}