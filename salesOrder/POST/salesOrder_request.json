{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sales Order Schema",
  "description": "JSON contract for Finish Good Orders including timestamps, separating header and detail.",
  "type": "object",
  "properties": {
    "header": {
      "type": "object",
      "properties": {
        "orderNO": {
          "type": "string",
          "maxLength": 25,
          "description": "Primary key for the order."
        },
        "article": {
          "type": "string",
          "maxLength": 50,
          "description": "Description of finished good."
        },
        "brandCode": {
          "type": "string",
          "maxLength": 10,
          "description": "Brand code."
        },
        "deliveryDate": {
          "type": ["string", "null"],
          "description": "Requested delivery date (optional). Format: DD-MM-YYYY"
        },
        "productGroup": {
          "type": "string",
          "maxLength": 50,
          "description": "Product group."
        },
        "orderType": {
          "type": "string",
          "enum": ["FOB", "CMT"],
          "maxLength": 50,
          "description": "Order type."
        },
        "sku": {
          "type": "string",
          "maxLength": 50,
          "description": "SKU of the finished good."
        },
        "unitCode": {
          "type": "string",
          "maxLength": 10,
          "description": "Unit of the finished good."
        },
        "soDate": {
          "type": ["string", "null"],
          "description": "Sales Order date (optional). Format: DD-MM-YYYY"
        }
      },
      "required": [
        "orderNO",
        "article",
        "brandCode",
        "productGroup",
        "poCust",
        "colorFinishGood",
        "sizeFinishGoodCode",
        "qtyOrder",
        "orderType",
        "sku",
        "unitCode"
      ]
    },
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {

          "poCust": {
            "type": "string",
            "maxLength": 50,
            "description": "Customer PO reference."
          },

          "colorFinishGood": {
            "type": "string",
            "maxLength": 250,
            "description": "Finish good color."
          },
          "sizeFinishGoodCode": {
            "type": "string",
            "maxLength": 10,
            "description": "Finish good size code."
          },
          "qtyOrder": {
            "type": "number",
            "description": "Quantity ordered."
          }
        },
        "required": [
          "colorFinishGood",
          "sizeFinishGoodCode",
          "qtyOrder"
        ]
      }
    }
  },
  "required": [
    "header",
    "details"
  ],
  "additionalProperties": false,
  
  "payload examples": [
    {
      "header": {
        "orderNO": "ADDON/ORDER/0001/V/2026",
        "article": "ERP",
        "brandCode": "ERP",
        "deliveryDate": "11-07-2026",
        "productGroup": "ERP",
        "orderType": "FOB",
        "sku": "ERP IT INVENTORY",
        "unitCode": "PCE",
        "soDate": "11-07-2026"
      },
      "details": [
        {
            "poCust": "CUSTOMER/PO-1",
            "colorFinishGood": "-",
            "sizeFinishGoodCode": "ALL SIZE",
            "qtyOrder": 1
        },

        {
            "poCust": "CUSTOMER/PO-2",
            "colorFinishGood": "-",
            "sizeFinishGoodCode": "ALL SIZE",
            "qtyOrder": 1
        }
      ]
    }
  ]
}
