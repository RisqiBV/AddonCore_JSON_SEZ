{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sales Order Response Schema",
  "description": "JSON response contract for Sales Order API.",
  "oneOf": [
    {
      "title": "Success Response",
      "description": "Response returned when Sales Order data is successfully saved.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "Success message."
        },
        "data": {
          "type": "array",
          "description": "Saved Sales Order data.",
          "items": {
            "type": "object",
            "properties": {
              "header": {
                "type": "object",
                "description": "Saved Sales Order header data.",
                "properties": {
                  "uuidHeader": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Unique identifier generated by the system for Sales Order header."
                  },
                  "orderNO": {
                    "type": "string",
                    "maxLength": 25,
                    "description": "Primary key for the order."
                  },
                  "article": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Description of finished good."
                  },
                  "brandCode": {
                    "type": "string",
                    "maxLength": 10,
                    "description": "Brand code."
                  },
                  "deliveryDate": {
                    "type": ["string", "null"],
                    "description": "Requested delivery date. Format: DD-MM-YYYY."
                  },
                  "productGroup": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Product group."
                  },
                  "orderType": {
                    "type": "string",
                    "enum": ["FOB", "CMT"],
                    "maxLength": 50,
                    "description": "Order type."
                  },
                  "sku": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "SKU of the finished good."
                  },
                  "unitCode": {
                    "type": "string",
                    "maxLength": 10,
                    "description": "Unit of the finished good."
                  }
                },
                "required": [
                  "uuidHeader",
                  "orderNO",
                  "article",
                  "brandCode",
                  "deliveryDate",
                  "productGroup",
                  "orderType",
                  "sku",
                  "unitCode"
                ],
                "additionalProperties": false
              },
              "details": {
                "type": "array",
                "description": "Saved Sales Order detail data.",
                "items": {
                  "type": "object",
                  "properties": {
                    "uuid": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier generated by the system for Sales Order detail."
                    },
                    "uuidHeader": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier of the related Sales Order header."
                    },
                    "poCust": {
                      "type": "string",
                      "maxLength": 50,
                      "description": "Customer PO reference."
                    },
                    "colorFinishGood": {
                      "type": "string",
                      "maxLength": 250,
                      "description": "Finish good color."
                    },
                    "sizeFinishGoodCode": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Finish good size code."
                    },
                    "qtyOrder": {
                      "type": "number",
                      "description": "Quantity ordered."
                    }
                  },
                  "required": [
                    "uuid",
                    "uuidHeader",
                    "poCust",
                    "colorFinishGood",
                    "sizeFinishGoodCode",
                    "qtyOrder"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "header",
              "details"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "message", "data"],
      "additionalProperties": false
    },
    {
      "title": "General Error Response",
      "description": "Response returned when validation, duplicate data, related data not found, or server error occurs.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["error"],
          "description": "Response status."
        },
        "message": {
          "type": "string",
          "description": "General error message."
        },
        "errors": {
          "type": ["object", "null"],
          "description": "Detailed error information. The object key represents the field name or error category.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": ["status", "message", "errors"],
      "additionalProperties": false
    }
  ],
  "responseExamples": {
    "success": {
      "status": "success",
      "message": "Data Sales Order successfully saved",
      "data": [
        {
          "header": {
            "uuidHeader": "d664006c-b21a-45ba-9e6d-e91c27c986b4",
            "orderNO": "ADDON/ORDER/0001/V/2026",
            "article": "ERP",
            "brandCode": "ERP",
            "deliveryDate": "11-07-2026",
            "productGroup": "ERP",
            "orderType": "FOB",
            "sku": "ERP IT INVENTORY",
            "unitCode": "PCE"
          },
          "details": [
            {
              "uuid": "485c2c71-f09e-431e-bb51-b3593c20a998",
              "uuidHeader": "d664006c-b21a-45ba-9e6d-e91c27c986b4",
              "poCust": "CUSTOMER/PO-1",
              "colorFinishGood": "-",
              "sizeFinishGoodCode": "ALL SIZE",
              "qtyOrder": 1
            },
            {
              "uuid": "80036138-1f5d-4d86-b094-1de0ec82ef4f",
              "uuidHeader": "d664006c-b21a-45ba-9e6d-e91c27c986b4",
              "poCust": "CUSTOMER/PO-2",
              "colorFinishGood": "-",
              "sizeFinishGoodCode": "ALL SIZE",
              "qtyOrder": 1
            }
          ]
        }
      ]
    },
    "validationError": {
      "status": "error",
      "message": "Validation failed",
      "errors": {
        "header.orderNO": [
          "The header.orderNO field is required."
        ],
        "header.brandCode": [
          "The header.brandCode field is required."
        ],
        "details": [
          "The details field is required and must contain at least one item."
        ],
        "details.0.qtyOrder": [
          "The details.0.qtyOrder must be a number."
        ]
      }
    },
    "duplicateError": {
      "status": "error",
      "message": "Duplicate data found",
      "errors": {
        "duplicate": [
          "The submitted Sales Order data already exists."
        ]
      }
    },
    "relatedDataNotFoundError": {
      "status": "error",
      "message": "Related data not found",
      "errors": {
        "brandCode": [
          "Brand data with the specified brandCode was not found."
        ],
        "unitCode": [
          "Unit data with the specified unitCode was not found."
        ]
      }
    },
    "serverError": {
      "status": "error",
      "message": "Internal server error",
      "errors": null
    }
  }
}