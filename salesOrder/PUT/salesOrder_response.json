{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Update Sales Order Response Schema",
  "description": "JSON response contract for updating Sales Order data. This response may include updated detail rows and newly inserted detail rows from the upsert process.",
  "oneOf": [
    {
      "title": "Success Response",
      "description": "Response returned when Sales Order data is successfully updated or processed through upsert.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success"],
          "description": "Response status."
        },
        "code": {
          "type": "string",
          "enum": ["SUCCESS"],
          "description": "Response code."
        },
        "message": {
          "type": "string",
          "description": "Success message."
        },
        "data": {
          "type": "array",
          "description": "Updated Sales Order data.",
          "items": {
            "type": "object",
            "properties": {
              "header": {
                "type": "object",
                "description": "Updated Sales Order header data.",
                "properties": {
                  "uuidHeader": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Unique identifier of the Sales Order header."
                  },
                  "orderNO": {
                    "type": "string",
                    "maxLength": 25,
                    "description": "Sales Order number."
                  },
                  "article": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Description of finished good."
                  },
                  "brandCode": {
                    "type": "string",
                    "maxLength": 10,
                    "description": "Brand code."
                  },
                  "deliveryDate": {
                    "type": ["string", "null"],
                    "description": "Requested delivery date. Format: DD-MM-YYYY."
                  },
                  "productGroup": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "Product group."
                  },
                  "orderType": {
                    "type": "string",
                    "enum": ["FOB", "CMT"],
                    "maxLength": 50,
                    "description": "Order type."
                  },
                  "sku": {
                    "type": "string",
                    "maxLength": 50,
                    "description": "SKU of the finished good."
                  },
                  "unitCode": {
                    "type": "string",
                    "maxLength": 10,
                    "description": "Unit of the finished good."
                  },
                  "updatedAt": {
                    "type": "string",
                    "description": "Date and time when the header data was updated."
                  }
                },
                "required": [
                  "uuidHeader",
                  "orderNO",
                  "article",
                  "brandCode",
                  "deliveryDate",
                  "productGroup",
                  "orderType",
                  "sku",
                  "unitCode",
                  "updatedAt"
                ],
                "additionalProperties": false
              },
              "details": {
                "type": "array",
                "description": "Updated and inserted Sales Order detail data. Existing detail rows are updated when uuid is provided in the request. New detail rows are inserted when uuid is not provided in the request.",
                "items": {
                  "type": "object",
                  "properties": {
                    "uuid": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier of the Sales Order detail."
                    },
                    "uuidHeader": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier of the related Sales Order header."
                    },
                    "poCust": {
                      "type": "string",
                      "maxLength": 50,
                      "description": "Customer PO reference."
                    },
                    "colorFinishGood": {
                      "type": "string",
                      "maxLength": 250,
                      "description": "Finish good color."
                    },
                    "sizeFinishGoodCode": {
                      "type": "string",
                      "maxLength": 10,
                      "description": "Finish good size code."
                    },
                    "qtyOrder": {
                      "type": ["number", "string"],
                      "description": "Quantity ordered."
                    },
                    "updatedAt": {
                      "type": "string",
                      "description": "Date and time when the detail data was updated or inserted."
                    }
                  },
                  "required": [
                    "uuid",
                    "uuidHeader",
                    "poCust",
                    "colorFinishGood",
                    "sizeFinishGoodCode",
                    "qtyOrder",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "header",
              "details"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "code", "message", "data"],
      "additionalProperties": false
    },
    {
      "title": "General Error Response",
      "description": "Response returned when validation, duplicate data, related data not found, or server error occurs.",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["error"],
          "description": "Response status."
        },
        "code": {
          "type": "string",
          "description": "Error code."
        },
        "message": {
          "type": "string",
          "description": "General error message."
        },
        "errors": {
          "type": ["object", "null"],
          "description": "Detailed error information. The object key represents the field name or error category.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": ["status", "message", "errors"],
      "additionalProperties": false
    }
